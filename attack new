-- ==========================================
-- [ STANDALONE FAST ATTACK / KILL AURA ]
-- ==========================================
local FastAttackModule = {}

-- Services
local GameService = game
local Players = GameService:GetService("Players")
local RunService = GameService:GetService("RunService")
local ReplicatedStorage = GameService:GetService("ReplicatedStorage")
local Workspace = GameService:GetService("Workspace")

-- Player
local LocalPlayer = Players.LocalPlayer

-- Helper function
local function SafeWaitForChild(parent, childName)
    local success, result = pcall(function()
        return parent:WaitForChild(childName, 5)
    end)
    return success and result or nil
end

-- Game objects
local Enemies = SafeWaitForChild(Workspace, "Enemies")
local Modules = SafeWaitForChild(ReplicatedStorage, "Modules")
local Net = SafeWaitForChild(Modules, "Net")

-- Configuration
FastAttackModule.Rate = 0.15 -- Tốc độ vung chiêu (Để 0.05 mượt và khó bị kick hơn)
FastAttackModule.Range = 60  -- Bán kính quét quái
FastAttackModule.Enabled = true

-- Core functions
function FastAttackModule.IsAlive(target)
    local humanoid = target:FindFirstChild("Humanoid")
    return humanoid and humanoid.Health > 0
end

-- Quét TẤT CẢ quái vật trong folder, không phân biệt tên
function FastAttackModule.GetNearbyTargets(character, folder)
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root or not folder then return {} end
    
    local characterPosition = root.Position
    local nearbyTargets = {}
    local children = folder:GetChildren()
    
    for i = 1, #children do
        local target = children[i]
        local rootPart = target:FindFirstChild("HumanoidRootPart")
        
        if rootPart and FastAttackModule.IsAlive(target) then
            local distance = (rootPart.Position - characterPosition).Magnitude
            if distance <= FastAttackModule.Range then
                table.insert(nearbyTargets, target)
            end
        end
    end
    return nearbyTargets
end

-- Hàm thực thi xả sát thương
function FastAttackModule.ExecuteAttack(targets)
    local char = LocalPlayer.Character
    if not char then return end
    
    -- Chỉ kiểm tra xem nhân vật CÓ ĐANG CẦM VŨ KHÍ trên tay hay không
    local currentTool = char:FindFirstChildOfClass("Tool")

    -- Nếu đang cầm vũ khí thì xả đòn, nếu cất đi thì không đánh
    if currentTool and Net then
        pcall(function()
            -- Click chuột mồi để client nhận lệnh vung vũ khí đang cầm
            currentTool:Activate()
            
            -- Gửi packet đăng ký nhịp đánh với tham số 0
            local regAttack = Net:FindFirstChild("RE/RegisterAttack")
            if regAttack then regAttack:FireServer(0) end
            
            -- Xả sát thương vào tất cả quái lọt vào mảng quét
            local regHit = Net:FindFirstChild("RE/RegisterHit")
            if regHit then
                for i = 1, #targets do
                    local target = targets[i]
                    local targetRoot = target:FindFirstChild("HumanoidRootPart") or target.PrimaryPart
                    if targetRoot then
                        regHit:FireServer(targetRoot, {{target, targetRoot}})
                    end
                end
            end
        end)
    end
end

-- ==========================================
-- [ KÍCH HOẠT SCRIPT ]
-- ==========================================

-- Chạy Bypass Animation chuẩn (Bắt buộc để RegisterHit có tác dụng)
pcall(function()
    loadstring(game:HttpGet("https://raw.githubusercontent.com/Giacchsbloxfruit/Giacyeuem/refs/heads/main/attack"))()
end)

-- Vòng lặp chạy ngầm Fast Attack
task.spawn(function()
    print(">>> FAST ATTACK STANDALONE ENABLED - RANGE: 60 <<<")
    while task.wait(FastAttackModule.Rate) do
        if FastAttackModule.Enabled and LocalPlayer.Character then
            -- Quét và lấy danh sách quái quanh người
            local targets = FastAttackModule.GetNearbyTargets(LocalPlayer.Character, Enemies)
            
            -- Nếu có quái trong tầm, lập tức chém
            if #targets > 0 then
                FastAttackModule.ExecuteAttack(targets)
            end
        end
    end
end)
