--======================================================--
-- AUTO HOP SERVER (OLDEST SERVER / LOWEST PLAYERS)
--======================================================--
local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")
local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GuiService = game:GetService("GuiService")

local PlaceID = game.PlaceId
local BlacklistFile = "AutoHopBlacklist.json"

local AllIDs = {}
local foundAnything = ""
local isHopping = false
local actualHour = os.date("!*t").hour

-- Hàm thông báo duy nhất trên màn hình
local function ShowNotification(title, text, duration)
    pcall(function() 
        StarterGui:SetCore("SendNotification", { Title = title, Text = text, Duration = duration or 5 }) 
    end)
end

-- Đọc Blacklist cũ để né server lỗi
pcall(function()
    if isfile and isfile(BlacklistFile) then
        local content = readfile(BlacklistFile)
        if content ~= "" then AllIDs = HttpService:JSONDecode(content) end
    end
end)

-- Reset Blacklist mỗi giờ đồng hồ để các server được làm mới
local function CheckBlacklistReset()
    if #AllIDs > 0 and AllIDs[1] ~= actualHour then
        pcall(function()
            delfile(BlacklistFile)
            AllIDs = {actualHour}
        end)
    elseif #AllIDs == 0 then
        table.insert(AllIDs, actualHour)
    end
end

local function GetServerList()
    local url
    if foundAnything == "" then
        url = 'https://games.roblox.com/v1/games/' .. PlaceID .. '/servers/Public?sortOrder=Asc&limit=100'
    else
        url = 'https://games.roblox.com/v1/games/' .. PlaceID .. '/servers/Public?sortOrder=Asc&limit=100&cursor=' .. foundAnything
    end
    
    local success, result = pcall(function() return game:HttpGet(url) end)
    if success then
        local data = HttpService:JSONDecode(result)
        if data and data.nextPageCursor then 
            foundAnything = data.nextPageCursor 
        else
            foundAnything = "" -- Reset cursor khi hết trang để vòng lặp tiếp tục quét lại từ đầu
        end
        return data.data or {}
    end
    return {}
end

-- Hàm thực thi Auto Hop (Ưu tiên Server cũ nhất / Ít người nhất)
local function StartAutoHop()
    CheckBlacklistReset()
    local servers = GetServerList()
    
    -- Sắp xếp danh sách server theo số lượng người chơi từ ÍT NHẤT đến NHIỀU NHẤT
    -- (Server ít người chơi nhất thường là các server đã chạy lâu đời)
    table.sort(servers, function(a, b)
        return (tonumber(a.playing) or 0) < (tonumber(b.playing) or 0)
    end)
    
    for _, serverInfo in pairs(servers) do
        local targetJobId = tostring(serverInfo.id)
        local isBlacklisted = false
        local playingCount = tonumber(serverInfo.playing) or 0
        local maxPlayers = tonumber(serverInfo.maxPlayers) or 0
        
        -- Điều kiện: Server còn hoạt động (>0 người) và chưa bị đưa vào sổ đen
        if playingCount > 0 and playingCount < maxPlayers then
            for _, existingID in pairs(AllIDs) do
                if targetJobId == tostring(existingID) then
                    isBlacklisted = true
                    break
                end
            end
            
            if not isBlacklisted and targetJobId ~= game.JobId then
                isHopping = true
                
                -- Ghi vào Blacklist ngay để không quay lại
                table.insert(AllIDs, targetJobId)
                pcall(function() writefile(BlacklistFile, HttpService:JSONEncode(AllIDs)) end)
                
                -- Hiển thị thông báo
                ShowNotification("Auto Hop", "Đang chuyển sang server cũ...", 3)
                task.wait(3)
                
                -- Bắt lỗi màn hình 771/773
                local errorConnection
                errorConnection = GuiService.ErrorMessageChanged:Connect(function(errorMsg)
                    if isHopping then
                        isHopping = false
                        if errorConnection then errorConnection:Disconnect() end
                        
                        -- Tự click OK đóng bảng lỗi
                        pcall(function()
                            local prompt = game:GetService("CoreGui").RobloxPromptGui.promptOverlay:FindFirstChild("ErrorPrompt")
                            if prompt then prompt.MessageArea.ErrorFrame.ButtonArea.OkButton:Click() end
                        end)
                        
                        task.wait(1.5)
                        StartAutoHop() -- Lỗi thì tiếp tục quét server tiếp theo
                    end
                end)
                
                -- Teleport bằng Remote của game
                task.spawn(function()
                    pcall(function()
                        ReplicatedStorage.__ServerBrowser:InvokeServer("teleport", targetJobId)
                    end)
                end)
                
                -- Timeout 15s nếu kẹt loading
                task.delay(15, function()
                    if isHopping then
                        isHopping = false
                        if errorConnection then errorConnection:Disconnect() end
                        StartAutoHop()
                    end
                end)
                
                return -- Dừng hàm để chờ dịch chuyển
            end
        end
    end
    
    -- Nếu danh sách server hiện tại đã duyệt hết hoặc bị trùng blacklist, quét tiếp trang sau
    task.wait(1)
    StartAutoHop()
end

-- Chạy script
StartAutoHop()
