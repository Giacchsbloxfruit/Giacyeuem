    local resizeConnection

    resizeConnection = RunService.RenderStepped:Connect(function()
        if not Main.Parent then
            resizeConnection:Disconnect()
            return
        end

        local viewport = GetViewport()

        if WindowData._lastViewport ~= viewport then
            WindowData._lastViewport = viewport
            UpdateLayout()
        end

        for _, particle in ipairs(Particles) do
            particle.Time += 0.008 * particle.Speed

            local p = particle.Object
            local base = particle.Base

            p.Position = UDim2.new(
                base.X.Scale + math.sin(particle.Time) * 0.002,
                0,
                base.Y.Scale + math.cos(particle.Time * 0.8) * 0.002,
                0
            )
        end
    end)

    UpdateLayout()

    return WindowData
