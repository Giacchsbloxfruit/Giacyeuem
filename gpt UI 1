    local function SelectTab(tab)
        if activeTab == tab then
            return
        end

        activeTab = tab

        for _, data in pairs(tabs) do
            local selected = data == tab

            Tween(data.Button, {
                BackgroundColor3 = selected and Theme.Surface2 or Theme.Background,
                BackgroundTransparency = selected and 0 or 1
            }, 0.15):Play()

            Tween(data.Bar, {
                BackgroundTransparency = selected and 0 or 1
            }, 0.15):Play()

            Tween(data.Text, {
                TextColor3 = selected and Theme.Text or Theme.SubText
            }, 0.15):Play()
        end

        ClearContent()

        for _, object in ipairs(tab.Elements) do
            object.Parent = ContentScroll
        end

        task.spawn(function()
            task.wait()
            ContentScroll.CanvasPosition = Vector2.zero
        end)
    end

