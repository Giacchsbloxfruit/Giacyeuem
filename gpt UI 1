        -- SECTION
        --==================================================

        function Tab:AddSection(title)

            local Section = {}
            Section.__index = Section

            local Frame = Create("Frame", {
                Parent = Page,
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundColor3 = Theme.Card,
                BorderSizePixel = 0
            })

            Corner(Frame, 12)
            Stroke(Frame, Theme.Stroke)

            local SectionTitle = TextLabel(
                Frame,
                title,
                17,
                Theme.AccentLight,
                Enum.Font.GothamMedium
            )

            SectionTitle.Position = UDim2.new(0, 20, 0, 13)
            SectionTitle.Size = UDim2.new(1, -40, 0, 28)

            local Container = Create("Frame", {
                Parent = Frame,
                Position = UDim2.new(0, 15, 0, 55),
                Size = UDim2.new(1, -30, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1
            })

            local Layout = Create("UIListLayout", {
                Parent = Container,
                Padding = UDim.new(0, 8),
                SortOrder = Enum.SortOrder.LayoutOrder
            })

            Padding(Frame, 0, 0, 0, 15)

            --================================================
            -- TOGGLE
            --================================================

            function Section:AddToggle(config)

                config = config or {}

                local Toggle = {
                    Value = config.Default or false
                }

                local Row = Create("TextButton", {
                    Parent = Container,
                    Size = UDim2.new(1, 0, 0, 62),
                    BackgroundColor3 = Theme.Card2,
                    BorderSizePixel = 0,
                    Text = "",
                    AutoButtonColor = false
                })

                Corner(Row, 9)

                local Label = TextLabel(
                    Row,
                    config.Name or "Toggle",
                    14,
                    Theme.Text,
                    Enum.Font.GothamMedium
                )

                Label.Position = UDim2.new(0, 15, 0, 9)
                Label.Size = UDim2.new(1, -100, 0, 22)

                local Description = TextLabel(
                    Row,
                    config.Description or "Toggle description.",
                    12,
                    Theme.SubText
                )

                Description.Position = UDim2.new(0, 15, 0, 32)
                Description.Size = UDim2.new(1, -100, 0, 20)

                local Switch = Create("Frame", {
                    Parent = Row,
                    AnchorPoint = Vector2.new(1, 0.5),
                    Position = UDim2.new(1, -15, 0.5, 0),
                    Size = UDim2.fromOffset(53, 28),
                    BackgroundColor3 = Theme.Card,
                    BorderSizePixel = 0
                })

                Corner(Switch, 20)

                local SwitchStroke = Stroke(Switch, Theme.Stroke)

                local Circle = Create("Frame", {
                    Parent = Switch,
                    Position = UDim2.new(0, 4, 0.5, -10),
                    Size = UDim2.fromOffset(20, 20),
                    BackgroundColor3 = Theme.SubText,
                    BorderSizePixel = 0
                })

                Corner(Circle, 20)

                function Toggle:Set(value)

                    Toggle.Value = value

                    if value then

                        Tween(Switch, {
                            BackgroundColor3 = Theme.Accent
                        })

                        Tween(Circle, {
                            Position = UDim2.new(1, -24, 0.5, -10),
                            BackgroundColor3 = Theme.Text
                        })

                    else

                        Tween(Switch, {
                            BackgroundColor3 = Theme.Card
                        })

                        Tween(Circle, {
                            Position = UDim2.new(0, 4, 0.5, -10),
                            BackgroundColor3 = Theme.SubText
                        })

                    end

                    if config.Callback then
                        task.spawn(config.Callback, value)
                    end

                end

                Row.MouseButton1Click:Connect(function()
                    Toggle:Set(not Toggle.Value)
                end)

                Toggle:Set(Toggle.Value)

                return Toggle
            end

            --================================================
            -- BUTTON
            --================================================

            function Section:AddButton(config)

                config = config or {}

                local Button = Create("TextButton", {
                    Parent = Container,
                    Size = UDim2.new(1, 0, 0, 58),
                    BackgroundColor3 = Theme.Accent,
                    BorderSizePixel = 0,
                    Text = "",
                    AutoButtonColor = false
                })

                Corner(Button, 9)

                local ButtonText = TextLabel(
                    Button,
                    config.Name or "Execute",
                    15,
                    Theme.Text,
                    Enum.Font.GothamMedium
                )

                ButtonText.Size = UDim2.new(1, 0, 1, 0)
                ButtonText.TextXAlignment = Enum.TextXAlignment.Center

                Button.MouseEnter:Connect(function()

                    Tween(Button, {
                        BackgroundColor3 = Theme.AccentLight
                    })

                end)

                Button.MouseLeave:Connect(function()

                    Tween(Button, {
                        BackgroundColor3 = Theme.Accent
                    })

                end)

                Button.MouseButton1Click:Connect(function()

                    Tween(Button, {
                        Size = UDim2.new(1, -4, 0, 54)
                    }, 0.08)

                    task.delay(0.08, function()
                        Tween(Button, {
                            Size = UDim2.new(1, 0, 0, 58)
                        }, 0.12)
                    end)

                    if config.Callback then
                        task.spawn(config.Callback)
                    end

                end)

                return Button
            end

            --================================================
            -- DROPDOWN
            --================================================

            function Section:AddDropdown(config)

                config = config or {}

                local Dropdown = {
                    Value = config.Default
                }

                local Holder = Create("Frame", {
                    Parent = Container,
                    Size = UDim2.new(1, 0, 0, 60),
                    BackgroundColor3 = Theme.Card2,
                    BorderSizePixel = 0,
                    ClipsDescendants = true
                })

                Corner(Holder, 9)

                local SelectButton = Create("TextButton", {
                    Parent = Holder,
                    Size = UDim2.new(1, 0, 0, 60),
                    BackgroundTransparency = 1,
                    Text = "",
                    AutoButtonColor = false
                })

                local Name = TextLabel(
                    SelectButton,
                    config.Name or "Dropdown",
                    14,
                    Theme.Text,
                    Enum.Font.GothamMedium
                )

                Name.Position = UDim2.new(0, 15, 0, 0)
                Name.Size = UDim2.new(0.5, 0, 1, 0)

                local Current = TextLabel(
                    SelectButton,
                    config.Default or "Select",
                    13,
                    Theme.SubText
                )

                Current.AnchorPoint = Vector2.new(1, 0)
                Current.Position = UDim2.new(1, -45, 0, 0)
                Current.Size = UDim2.fromOffset(170, 60)
                Current.TextXAlignment = Enum.TextXAlignment.Right

                local Arrow = TextLabel(
                    SelectButton,
                    "⌄",
                    20,
                    Theme.AccentLight
                )

                Arrow.AnchorPoint = Vector2.new(1, 0.5)
                Arrow.Position = UDim2.new(1, -15, 0.5, 0)
                Arrow.Size = UDim2.fromOffset(20, 25)

                local List = Create("ScrollingFrame", {
                    Parent = Holder,
                    Position = UDim2.new(0, 10, 0, 65),
                    Size = UDim2.new(1, -20, 0, 150),
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                    ScrollBarThickness = 2,
                    ScrollBarImageColor3 = Theme.Accent
                })

                local ListLayout = Create("UIListLayout", {
                    Parent = List,
                    Padding = UDim.new(0, 5)
                })

                local open = false

                for _, option in ipairs(config.Options or {}) do

                    local OptionButton = Create("TextButton", {
                        Parent = List,
                        Size = UDim2.new(1, 0, 0, 38),
                        BackgroundColor3 = Theme.Card,
                        BorderSizePixel = 0,
                        Text = option,
                        TextColor3 = Theme.SubText,
                        TextSize = 13,
                        Font = Enum.Font.Gotham,
                        AutoButtonColor = false
                    })

                    Corner(OptionButton, 7)

                    OptionButton.MouseEnter:Connect(function()

                        Tween(OptionButton, {
                            BackgroundColor3 = Theme.Accent,
                            TextColor3 = Theme.Text
                        })

                    end)

                    OptionButton.MouseLeave:Connect(function()

                        if Dropdown.Value ~= option then

                            Tween(OptionButton, {
                                BackgroundColor3 = Theme.Card,
                                TextColor3 = Theme.SubText
                            })

                        end

                    end)

                    OptionButton.MouseButton1Click:Connect(function()

                        Dropdown.Value = option
                        Current.Text = option

                        open = false

                        Tween(Holder, {
                            Size = UDim2.new(1, 0, 0, 60)
                        })

                        Tween(Arrow, {
                            Rotation = 0
                        })

                        if config.Callback then
                            task.spawn(config.Callback, option)
                        end

                    end)

                end

                function Dropdown:Set(value)

                    Dropdown.Value = value
                    Current.Text = tostring(value)

                    if config.Callback then
                        task.spawn(config.Callback, value)
                    end

                end

                SelectButton.MouseButton1Click:Connect(function()

                    open = not open

                    if open then

                        local optionCount = math.min(
                            #(config.Options or {}),
                            4
                        )

                        local height = 70 + (optionCount * 43)

                        Tween(Holder, {
                            Size = UDim2.new(1, 0, 0, height)
                        })

                        Tween(Arrow, {
                            Rotation = 180
                        })

                    else

                        Tween(Holder, {
                            Size = UDim2.new(1, 0, 0, 60)
                        })

                        Tween(Arrow, {
                            Rotation = 0
                        })

                    end

                end)

                return Dropdown
            end

            --================================================
            -- LABEL
            --================================================

            function Section:AddLabel(text)

                local Label = TextLabel(
                    Container,
                    text,
                    13,
                    Theme.SubText
                )

                Label.Size = UDim2.new(1, 0, 0, 35)

                return Label
            end

            --================================================
            -- DIVIDER
            --================================================

            function Section:AddDivider()

                local Divider = Create("Frame", {
                    Parent = Container,
                    Size = UDim2.new(1, 0, 0, 1),
                    BackgroundColor3 = Theme.Stroke,
                    BorderSizePixel = 0
                })

                return Divider
            end

            table.insert(Tab.Sections, Section)

            return Section
        end

        Window.Tabs[name] = Tab

        if not Window.CurrentTab then
            Tab:Activate()
        end

        return Tab
    end

    -- Alias
    Window.AddTab = Window.AddTabs

    --======================================================
    -- INITIAL ANIMATION
    --======================================================

    Main.Size = UDim2.fromOffset(
        (options.Size or CONFIG.Size).X.Offset * 0.92,
        (options.Size or CONFIG.Size).Y.Offset * 0.92
    )

    Main.BackgroundTransparency = 1

    Tween(Main, {
        Size = options.Size or CONFIG.Size,
        BackgroundTransparency = 0
    }, 0.45)

    return Window
end

return Axiom
