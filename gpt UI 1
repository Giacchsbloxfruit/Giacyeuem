                    ZIndex = 11
                }, Holder)

                local Key = New("TextLabel", {
                    BackgroundColor3 = Theme.Background,
                    AnchorPoint = Vector2.new(1, 0.5),
                    Position = UDim2.new(1, -9, 0.5, 0),
                    Size = UDim2.fromOffset(90, 26),
                    Font = Enum.Font.Gotham,
                    Text = default and default.Name or "None",
                    TextColor3 = Theme.SubText,
                    TextSize = 8,
                    ZIndex = 11
                }, Holder)

                Corner(Key, 6)
                Stroke(Key, Theme.Stroke, 1, 0.2)

                local listening = false
                local currentKey = default

                Holder.MouseButton1Click:Connect(function()
                    if listening then
                        return
                    end

                    listening = true
                    Key.Text = "Press key..."
                    Key.TextColor3 = Theme.White
                end)

                local connection

                connection = UserInputService.InputBegan:Connect(function(input, processed)
                    if processed then
                        return
                    end

                    if listening then
                        if input.UserInputType == Enum.UserInputType.Keyboard then
                            currentKey = input.KeyCode
                            Key.Text = input.KeyCode.Name
                            Key.TextColor3 = Theme.SubText
                            listening = false
                        end
                    elseif currentKey and input.KeyCode == currentKey then
                        if callback then
                            task.spawn(callback)
                        end
                    end
                end)

                ScreenGui.Destroying:Connect(function()
                    if connection then
                        connection:Disconnect()
                    end
                end)

                return {
                    Set = function(key)
                        currentKey = key
                        Key.Text = key and key.Name or "None"
                    end,
                    Get = function()
                        return currentKey
                    end
                }
            end

