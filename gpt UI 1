		--====================================================

		function Tab:Activate()

			for _, other
				in ipairs(
					Window.TabOrder
				) do

				if other ~= Tab then

					other.Page.Visible =
						false

					Tween(
						other.TabBackground,
						{
							BackgroundTransparency =
								1
						},
						0.1
					)

					Tween(
						other.TabText,
						{
							TextColor3 =
								Theme.SubText
						},
						0.1
					)

					Tween(
						other.Icon,
						{
							TextColor3 =
								Theme.Muted
						},
						0.1
					)

					Tween(
						other.Indicator,
						{
							BackgroundTransparency =
								1
						},
						0.1
					)

				end

			end

			Page.Visible = true

			Tween(
				TabBackground,
				{
					BackgroundTransparency =
						0
				},
				0.12
			)

			Tween(
				TabText,
				{
					TextColor3 =
						Theme.White
				},
				0.12
			)

			Tween(
				Icon,
				{
					TextColor3 =
						Theme.White
				},
				0.12
			)

			Tween(
				Indicator,
				{
					BackgroundTransparency =
						0
				},
				0.12
			)

			Window.CurrentTab =
				Tab

			MoveOrbs()

		end

		TabButton.MouseEnter:Connect(
			function()

				if Window.CurrentTab
					~= Tab then

					Tween(
						TabBackground,
						{
							BackgroundTransparency =
								0.35
						},
						0.1
					)

				end

			end
		)

		TabButton.MouseLeave:Connect(
			function()

				if Window.CurrentTab
					~= Tab then

					Tween(
						TabBackground,
						{
							BackgroundTransparency =
								1
						},
						0.1
					)

				end

			end
		)

		TabButton.MouseButton1Click:Connect(
			function()

				Tab:Activate()

			end
		)

