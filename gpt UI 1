        function Tab:AddSlider(options)
            options = options or {}

            local min = options.Min or 0
            local max = options.Max or 100
            local value = math.clamp(
                options.Default or min,
                min,
                max
            )

            local callback = options.Callback or function() end

            local Holder = New("Frame", {
                Size = UDim2.new(1,0,0,65),
                BackgroundColor3 = Theme.Element,
                BorderSizePixel = 0,
                LayoutOrder = #Tab.Elements + 1,
                ZIndex = 8
            }, Page)

            Corner(Holder,9)
            Stroke(Holder,Theme.Border,1,0.3)

            local Label = New("TextLabel", {
                Size = UDim2.new(0.7,0,0,22),
                Position = UDim2.new(0,12,0,7),
                BackgroundTransparency = 1,
                Text = options.Name or "Slider",
                Font = Enum.Font.Gotham,
                TextSize = 10,
                TextColor3 = Theme.Text,
                TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex = 9
            }, Holder)

            local ValueLabel = New("TextLabel", {
                Size = UDim2.new(0.25,0,0,22),
                AnchorPoint = Vector2.new(1,0),
                Position = UDim2.new(1,-12,0,7),
                BackgroundTransparency = 1,
                Text = tostring(value),
                Font = Enum.Font.Gotham,
                TextSize = 10,
                TextColor3 = Theme.SubText,
                TextXAlignment = Enum.TextXAlignment.Right,
                ZIndex = 9
            }, Holder)

            local Bar = New("Frame", {
                Size = UDim2.new(1,-24,0,5),
                Position = UDim2.new(0,12,0,45),
                BackgroundColor3 = Color3.fromRGB(28,28,34),
                BorderSizePixel = 0,
                ZIndex = 9
            }, Holder)

            Corner(Bar,100)

            local Fill = New("Frame", {
                Size = UDim2.new(
                    (value-min)/(max-min),
                    0,
                    1,
                    0
                ),
                BackgroundColor3 = Theme.Text,
                BorderSizePixel = 0,
                ZIndex = 10
            }, Bar)

            Corner(Fill,100)

            local Drag = New("TextButton", {
                Size = UDim2.new(1,16,1,20),
                Position = UDim2.new(0,-8,0,-10),
                BackgroundTransparency = 1,
                Text = "",
                ZIndex = 11
            }, Bar)

            local dragging = false

            local function Update(input)
                local percent = math.clamp(
                    (input.Position.X - Bar.AbsolutePosition.X)
                    / Bar.AbsoluteSize.X,
                    0,
                    1
                )

                value = min + (max-min)*percent

                if options.Rounding then
                    local power = 10 ^ options.Rounding
                    value = math.floor(value*power+0.5)/power
                else
                    value = math.floor(value+0.5)
                end

                Fill.Size = UDim2.fromScale(percent,1)
                ValueLabel.Text = tostring(value)

                task.spawn(function()
                    pcall(callback,value)
                end)
            end

            Drag.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    Update(input)
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if dragging and (
                    input.UserInputType == Enum.UserInputType.MouseMovement
                    or input.UserInputType == Enum.UserInputType.Touch
                ) then
                    Update(input)
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)

            local Slider = {}

            function Slider:Set(newValue)
                value = math.clamp(newValue,min,max)

                local percent = (value-min)/(max-min)

                Fill.Size = UDim2.fromScale(percent,1)
                ValueLabel.Text = tostring(value)

                task.spawn(function()
                    pcall(callback,value)
                end)
            end

            function Slider:Get()
                return value
            end

            table.insert(Tab.Elements,Slider)

            return Slider
        end

