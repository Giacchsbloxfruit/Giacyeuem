                        ZIndex = 25
                    }, List)

                    Corner(Item,7)

                    BindClick(Item,function()
                        current = item
                        Selected.Text = tostring(item)

                        task.spawn(function()
                            pcall(callback,item)
                        end)

                        Close()
                    end)
                end
            end

            BindClick(MainButton,function()
                if opened then
                    Close()
                else
                    Rebuild()
                    Open()
                end
            end)

            Rebuild()

            local Dropdown = {}

            function Dropdown:Set(value)
                current = value
                Selected.Text = tostring(value)

                task.spawn(function()
                    pcall(callback,value)
                end)
            end

            function Dropdown:SetValues(newValues)
                values = newValues
                Rebuild()
            end

            function Dropdown:Get()
                return current
            end

            table.insert(Tab.Elements,Dropdown)

            return Dropdown
        end

