                1
            )

            --================================================
            -- HEADER
            --================================================

            local Header = Create("Frame", {

                Parent = Frame,

                Size =
                    UDim2.new(
                        1,
                        0,
                        0,
                        44
                    ),

                BackgroundTransparency = 1,

                ZIndex = 18

            })

            local HeaderText = Label(
                Header,
                Name,
                12,
                Theme.Text,
                Enum.Font.GothamMedium
            )

            HeaderText.Position =
                UDim2.fromOffset(
                    14,
                    0
                )

            HeaderText.Size =
                UDim2.new(
                    1,
                    -28,
                    1,
                    0
                )

            HeaderText.ZIndex = 19

            local HeaderLine = Create(
                "Frame",
                {
                    Parent = Frame,

                    Position =
                        UDim2.new(
                            0,
                            14,
                            0,
                            43
                        ),

                    Size =
                        UDim2.new(
                            1,
                            -28,
                            0,
                            1
                        ),

                    BackgroundColor3 =
                        Theme.Border,

                    BorderSizePixel = 0,

                    ZIndex = 19
                }
            )

            local Container = Create(
                "Frame",
                {
                    Parent = Frame,

                    Position =
                        UDim2.fromOffset(
                            11,
                            51
                        ),

                    Size =
                        UDim2.new(
                            1,
                            -22,
                            0,
                            0
                        ),

                    AutomaticSize =
                        Enum.AutomaticSize.Y,

                    BackgroundTransparency = 1,

                    ZIndex = 18
                }
            )

            local ContainerLayout = Create(
                "UIListLayout",
                {
                    Parent = Container,

                    FillDirection =
                        Enum.FillDirection.Vertical,

                    HorizontalAlignment =
                        Enum.HorizontalAlignment.Center,

                    VerticalAlignment =
                        Enum.VerticalAlignment.Top,

                    Padding =
                        UDim.new(0, 6),

                    SortOrder =
                        Enum.SortOrder.LayoutOrder,
                }
            )

            --================================================
            -- TOGGLE
            --================================================

            function Section:AddToggle(Config)

                Config = Config or {}

                local Toggle = {}

                Toggle.Value =
                    Config.Default or false

                local Row =
                    TextButton(Container)

                Row.Size =
                    UDim2.new(
                        1,
                        0,
                        0,
                        51
                    )

                Row.BackgroundColor3 =
                    Theme.Background2

                Row.BackgroundTransparency = 0

                Row.ZIndex = 19

                Corner(Row, 7)

                Stroke(
                    Row,
                    Theme.Border,
                    0,
                    1
                )

                local NameText = Label(
                    Row,
                    Config.Name or "Toggle",
                    11,
                    Theme.Text,
                    Enum.Font.GothamMedium
                )

                NameText.Position =
                    UDim2.fromOffset(
                        12,
                        5
                    )

                NameText.Size =
                    UDim2.new(
                        1,
                        -95,
                        0,
                        18
                    )

                NameText.ZIndex = 20

                local Description = Label(
                    Row,
                    Config.Description
                        or "Toggle description.",
                    9,
                    Theme.Muted
                )

                Description.Position =
                    UDim2.fromOffset(
                        12,
                        26
                    )

                Description.Size =
                    UDim2.new(
                        1,
                        -95,
                        0,
                        16
                    )

                Description.ZIndex = 20

                local Switch = Create(
                    "Frame",
                    {
                        Parent = Row,

                        AnchorPoint =
                            Vector2.new(
                                1,
                                0.5
                            ),

                        Position =
                            UDim2.new(
                                1,
                                -12,
                                0.5,
                                0
                            ),

                        Size =
                            UDim2.fromOffset(
                                42,
                                22
                            ),

                        BackgroundColor3 =
                            Theme.Background,

                        BorderSizePixel = 0,

                        ZIndex = 20
                    }
                )

                Corner(Switch, 11)

                Stroke(
                    Switch,
                    Theme.Border
                )

                local Knob = Create(
                    "Frame",
                    {
                        Parent = Switch,

                        Position =
                            UDim2.new(
                                0,
                                4,
                                0.5,
                                -7
                            ),

                        Size =
                            UDim2.fromOffset(
                                14,
                                14
                            ),

                        BackgroundColor3 =
                            Theme.Muted,

                        BorderSizePixel = 0,

                        ZIndex = 21
                    }
                )

                Corner(Knob, 8)

                function Toggle:Set(Value)

                    Toggle.Value = Value

                    if Value then

                        Tween(
                            Switch,
                            {
                                BackgroundColor3 =
                                    Theme.White
                            },
                            0.13
                        )

                        Tween(
                            Knob,
                            {
                                Position =
                                    UDim2.new(
                                        1,
                                        -18,
                                        0.5,
                                        -7
                                    ),

                                BackgroundColor3 =
                                    Theme.Black
                            },
                            0.13
                        )

                    else

                        Tween(
                            Switch,
                            {
                                BackgroundColor3 =
                                    Theme.Background
                            },
                            0.13
                        )

                        Tween(
                            Knob,
                            {
                                Position =
                                    UDim2.new(
                                        0,
                                        4,
                                        0.5,
                                        -7
                                    ),

                                BackgroundColor3 =
                                    Theme.Muted
                            },
                            0.13
                        )

                    end

                    if Config.Callback then

                        task.spawn(
                            Config.Callback,
                            Value
                        )

                    end

                end

                Row.MouseButton1Click:Connect(
                    function()

                        Toggle:Set(
                            not Toggle.Value
                        )

                    end
                )

                Toggle:Set(
                    Toggle.Value
                )

                return Toggle

            end

            --================================================
            -- BUTTON
            --================================================

            function Section:AddButton(Config)

                Config = Config or {}

                local Object =
                    TextButton(Container)

                Object.Size =
                    UDim2.new(
                        1,
                        0,
                        0,
                        40
                    )

                Object.BackgroundColor3 =
                    Theme.White

                Object.BorderSizePixel = 0

                Object.ZIndex = 19

                Corner(Object, 7)

                local Text = Label(
                    Object,
                    Config.Name or "Execute",
                    11,
                    Theme.Black,
                    Enum.Font.GothamMedium
                )

                Text.Size =
                    UDim2.fromScale(
                        1,
                        1
                    )

                Text.TextXAlignment =
                    Enum.TextXAlignment.Center

                Text.ZIndex = 20

                Object.MouseEnter:Connect(
                    function()

                        Tween(
                            Object,
                            {
                                BackgroundColor3 =
                                    Theme.Text
                            },
                            0.12
                        )

                    end
                )

                Object.MouseLeave:Connect(
                    function()

                        Tween(
                            Object,
                            {
                                BackgroundColor3 =
                                    Theme.White
                            },
                            0.12
                        )

                    end
                )

                Object.MouseButton1Click:Connect(
                    function()

                        if Config.Callback then

                            task.spawn(
                                Config.Callback
                            )

                        end

                    end
                )

                return Object

            end

            --================================================
            -- DROPDOWN
            --================================================

            function Section:AddDropdown(Config)

                Config = Config or {}

                local Dropdown = {}

                Dropdown.Value =
                    Config.Default or
                    (
                        Config.Options
                        and
                        Config.Options[1]
                    )

                local Open = false

                local Holder = Create(
                    "Frame",
                    {
                        Parent = Container,

                        Size =
                            UDim2.new(
                                1,
                                0,
                                0,
                                40
                            ),

                        BackgroundColor3 =
                            Theme.Background2,

                        BorderSizePixel = 0,

                        ClipsDescendants = true,

                        ZIndex = 19
                    }
                )

                Corner(Holder, 7)

                Stroke(
                    Holder,
                    Theme.Border,
                    0,
                    1
                )

                local Select =
                    TextButton(Holder)

                Select.Size =
                    UDim2.new(
                        1,
                        0,
                        0,
                        40
                    )

                Select.ZIndex = 20

                local NameText =
                    Label(
                        Select,
                        Config.Name
                            or "Dropdown",
                        11,
                        Theme.Text,
                        Enum.Font.GothamMedium
                    )

                NameText.Position =
                    UDim2.fromOffset(
                        12,
                        0
                    )

                NameText.Size =
                    UDim2.new(
                        0.5,
                        0,
                        1,
                        0
                    )

                NameText.ZIndex = 21

                local Current =
                    Label(
                        Select,
                        tostring(
                            Dropdown.Value
                            or
                            "Select"
                        ),
                        10,
                        Theme.SubText
                    )

                Current.AnchorPoint =
                    Vector2.new(
                        1,
                        0
                    )

                Current.Position =
                    UDim2.new(
                        1,
                        -34,
                        0,
                        0
                    )

                Current.Size =
                    UDim2.new(
                        0.35,
                        0,
                        1,
                        0
                    )

                Current.TextXAlignment =
                    Enum.TextXAlignment.Right

                Current.ZIndex = 21

                local Arrow =
                    Label(
                        Select,
                        "⌄",
                        14,
                        Theme.White
                    )

                Arrow.AnchorPoint =
                    Vector2.new(
                        1,
                        0.5
                    )

                Arrow.Position =
                    UDim2.new(
                        1,
                        -9,
                        0.5,
                        0
                    )

                Arrow.Size =
                    UDim2.fromOffset(
                        14,
                        18
                    )

                Arrow.TextXAlignment =
                    Enum.TextXAlignment.Center

                Arrow.ZIndex = 21

                local List =
                    Create(
                        "ScrollingFrame",
                        {
                            Parent = Holder,

                            Position =
                                UDim2.new(
                                    0,
                                    7,
                                    0,
                                    45
                                ),

                            Size =
                                UDim2.new(
                                    1,
                                    -14,
                                    0,
                                    110
                                ),

                            BackgroundTransparency = 1,

                            BorderSizePixel = 0,

                            ScrollBarThickness = 2,

                            ScrollBarImageColor3 =
                                Theme.White,

                            ZIndex = 21
                        }
                    )

                local ListLayout =
                    Create(
                        "UIListLayout",
                        {
                            Parent = List,

                            Padding =
                                UDim.new(
                                    0,
                                    4
                                ),

                            SortOrder =
                                Enum.SortOrder.LayoutOrder
                        }
                    )

                local OptionCount = 0

                for _, Option in ipairs(
                    Config.Options or {}
                ) do

                    OptionCount += 1

                    local OptionButton =
                        TextButton(List)

                    OptionButton.Size =
                        UDim2.new(
                            1,
                            -2,
                            0,
                            32
                        )

                    OptionButton.BackgroundColor3 =
                        Theme.Card

                    OptionButton.ZIndex = 22

                    Corner(
                        OptionButton,
                        6
                    )

                    local OptionText =
                        Label(
                            OptionButton,
                            tostring(Option),
                            10,
                            Theme.SubText
                        )

                    OptionText.Size =
                        UDim2.fromScale(
                            1,
                            1
                        )

                    OptionText.Position =
                        UDim2.fromOffset(
                            10,
                            0
                        )

                    OptionText.ZIndex = 23

                    OptionButton.MouseEnter:Connect(
                        function()

                            Tween(
                                OptionButton,
                                {
                                    BackgroundColor3 =
                                        Theme.White
                                },
                                0.1
                            )

                            Tween(
                                OptionText,
                                {
                                    TextColor3 =
                                        Theme.Black
                                },
                                0.1
                            )

                        end
                    )

                    OptionButton.MouseLeave:Connect(
                        function()

                            Tween(
                                OptionButton,
                                {
                                    BackgroundColor3 =
                                        Theme.Card
                                },
                                0.1
                            )

                            Tween(
                                OptionText,
                                {
                                    TextColor3 =
                                        Theme.SubText
                                },
                                0.1
                            )

                        end
                    )

                    OptionButton.MouseButton1Click:Connect(
                        function()

                            Dropdown.Value =
                                Option

                            Current.Text =
                                tostring(
                                    Option
                                )

                            Open = false

                            Tween(
                                Holder,
                                {
                                    Size =
                                        UDim2.new(
                                            1,
                                            0,
                                            0,
                                            40
                                        )
                                },
                                0.16
                            )

                            Arrow.Rotation = 0

                            if Config.Callback then

                                task.spawn(
                                    Config.Callback,
                                    Option
                                )

                            end

                        end
                    )

                end

                Select.MouseButton1Click:Connect(
                    function()

                        Open = not Open

                        if Open then

                            local VisibleOptions =
                                math.min(
                                    OptionCount,
                                    3
                                )

                            local Height =
                                45 +
                                VisibleOptions * 36

                            Tween(
                                Holder,
                                {
                                    Size =
                                        UDim2.new(
                                            1,
                                            0,
                                            0,
                                            Height
                                        )
                                },
                                0.18
                            )

                            Arrow.Rotation = 180

                        else

                            Tween(
                                Holder,
                                {
                                    Size =
                                        UDim2.new(
                                            1,
                                            0,
                                            0,
                                            40
                                        )
                                },
                                0.18
                            )

                            Arrow.Rotation = 0

                        end

                    end
                )

                function Dropdown:Set(Value)

                    Dropdown.Value = Value

                    Current.Text =
                        tostring(Value)

                    if Config.Callback then

                        task.spawn(
                            Config.Callback,
                            Value
                        )

                    end

                end

                return Dropdown

            end

            --================================================
            -- LABEL
            --================================================

            function Section:AddLabel(Text)

                local Object =
                    Label(
                        Container,
                        Text or "",
                        10,
                        Theme.Muted
                    )

                Object.Size =
                    UDim2.new(
                        1,
                        0,
                        0,
                        25
                    )

                Object.ZIndex = 20

                return Object

            end

            table.insert(
                Tab.Sections,
                Section
            )

            return Section

        end

        --====================================================
        -- SAVE TAB
        --====================================================

        Tab.TabButton = TabButton
        Tab.Page = Page
        Tab.Icon = Icon
        Tab.TabText = TabText
        Tab.Indicator = Indicator

        Window.Tabs[Name] = Tab

        table.insert(
            Window.TabOrder,
            Tab
        )

        UpdateTabCanvas()

        --====================================================
        -- IMPORTANT:
        -- Update width AFTER the ScrollingFrame has rendered.
        --====================================================

        task.defer(function()
            UpdateTabWidth()
        end)

        --====================================================
        -- FIRST TAB
        --====================================================

        if not Window.CurrentTab then

            task.defer(function()

                Tab:Activate()

            end)

        end

        return Tab

    end

    Window.AddTab =
        Window.AddTabs

    --========================================================
    -- OPEN ANIMATION
    --========================================================

    Shell.Size =
        UDim2.fromOffset(
            850,
            525
        )

    OuterBorder.BackgroundTransparency = 1

    Tween(
        Shell,
        {
            Size =
                UDim2.fromOffset(
                    WINDOW_WIDTH,
                    WINDOW_HEIGHT
                )
        },
        0.32
    )

    Tween(
        OuterBorder,
        {
            BackgroundTransparency = 0
        },
        0.32
    )

    return Window
end

return Axiom
