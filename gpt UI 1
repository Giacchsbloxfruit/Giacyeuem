            --================================================
            -- KEYBIND
            --================================================

            function Section:AddKeybind(Config)

                Config = Config or {}

                local Keybind = {}

                Keybind.Key =
                    Config.Key
                    or Enum.KeyCode.RightControl

                local Row = Create("Frame", {
                    Parent = Container,

                    Size =
                        UDim2.new(1,0,0,44),

                    BackgroundColor3 =
                        Theme.Background2,

                    BorderSizePixel = 0
                })

                Corner(Row,8)

                Stroke(
                    Row,
                    Theme.BorderSoft
                )

                local Name = Label(
                    Row,
                    Config.Name or "Keybind",
                    11,
                    Theme.Text,
                    Enum.Font.GothamMedium
                )

                Name.Position =
                    UDim2.new(0,12,0,0)

                Name.Size =
                    UDim2.new(0.5,0,1,0)

                local KeyButton = Button(Row)

                KeyButton.AnchorPoint =
                    Vector2.new(1,0.5)

                KeyButton.Position =
                    UDim2.new(1,-10,0.5,0)

                KeyButton.Size =
                    UDim2.fromOffset(100,28)

                KeyButton.BackgroundColor3 =
                    Theme.Card

                Corner(KeyButton,6)

                Stroke(
                    KeyButton,
                    Theme.Border
                )

                local KeyText = Label(
                    KeyButton,
                    Keybind.Key.Name,
                    10,
                    Theme.SubText,
                    Enum.Font.GothamMedium
                )

                KeyText.Size =
                    UDim2.fromScale(1,1)

                KeyText.TextXAlignment =
                    Enum.TextXAlignment.Center

                local Listening = false

                KeyButton.MouseButton1Click:Connect(
                    function()

                        if Listening then
                            return
                        end

                        Listening = true

                        KeyText.Text = "PRESS KEY"
                        KeyText.TextColor3 =
                            Theme.White

                    end
                )

                UserInputService.InputBegan:Connect(
                    function(Input,Processed)

                        if Processed then
                            return
                        end

                        if Listening then

                            if Input.KeyCode ~=
                                Enum.KeyCode.Unknown then

                                Keybind.Key =
                                    Input.KeyCode

                                KeyText.Text =
                                    Input.KeyCode.Name

                                Listening = false

                            end

                            return
                        end

                        if Input.KeyCode ==
                            Keybind.Key then

                            if Config.Callback then

                                task.spawn(
                                    Config.Callback
                                )

                            end

                        end

                    end
                )

                function Keybind:Set(Key)

                    Keybind.Key = Key
                    KeyText.Text = Key.Name

                end

                return Keybind

            end

