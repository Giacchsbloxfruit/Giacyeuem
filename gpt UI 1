    local dragging = false
    local dragStart
    local startPos

    TopBar.InputBegan:Connect(function(input)

        if input.UserInputType == Enum.UserInputType.MouseButton1 then

            dragging = true
            dragStart = input.Position
            startPos = Main.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)

        end

    end)

    UserInputService.InputChanged:Connect(function(input)

        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then

            local delta = input.Position - dragStart

            Main.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )

        end

    end)

    --//====================================================
    --// TAB
    --//====================================================

    function Window:AddTabs(name)

        local Tab = {}
        Tab.__index = Tab

        Tab.Name = name
        Tab.Sections = {}

        local Button = Create("TextButton", {
            Parent = TabHolder,
            Size = UDim2.new(1, 0, 0, 48),
            BackgroundColor3 = Theme.Accent,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Text = "",
            AutoButtonColor = false
        })

        Corner(Button, 10)

        local Icon = TextLabel(
            Button,
            "◆",
            17,
            Theme.SubText,
            Enum.Font.GothamBold
        )

        Icon.Position = UDim2.new(0, 18, 0, 0)
        Icon.Size = UDim2.fromOffset(24, 48)

        local TabName = TextLabel(
            Button,
            name,
            14,
            Theme.SubText,
            Enum.Font.GothamMedium
        )

        TabName.Position = UDim2.new(0, 55, 0, 0)
        TabName.Size = UDim2.new(1, -60, 1, 0)

        local Page = Create("ScrollingFrame", {
            Parent = Content,
            Position = UDim2.new(0, 40, 0, 25),
            Size = UDim2.new(1, -80, 1, -50),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = Theme.Accent,
            Visible = false,
            CanvasSize = UDim2.new(),
            AutomaticCanvasSize = Enum.AutomaticSize.Y
        })

        local PageLayout = Create("UIListLayout", {
            Parent = Page,
            Padding = UDim.new(0, 18),
            SortOrder = Enum.SortOrder.LayoutOrder
        })

        PageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            Page.CanvasSize = UDim2.new(
                0,
                0,
                0,
                PageLayout.AbsoluteContentSize.Y + 20
            )
        end)

        function Tab:Activate()

            for _, other in pairs(Window.Tabs) do

                other.Page.Visible = false

                Tween(other.Button, {
                    BackgroundTransparency = 1
                })

                Tween(other.Icon, {
                    TextColor3 = Theme.SubText
                })

                Tween(other.TabName, {
                    TextColor3 = Theme.SubText
                })

            end

            Page.Visible = true

            Tween(Button, {
                BackgroundTransparency = 0
            })

            Tween(Icon, {
                TextColor3 = Theme.Text
            })

            Tween(TabName, {
                TextColor3 = Theme.Text
            })

            Window.CurrentTab = Tab
        end

        Button.MouseButton1Click:Connect(function()
            Tab:Activate()
        end)

        Button.MouseEnter:Connect(function()

            if Window.CurrentTab ~= Tab then
                Tween(Button, {
                    BackgroundTransparency = 0.75
                })
            end

        end)

        Button.MouseLeave:Connect(function()

            if Window.CurrentTab ~= Tab then
                Tween(Button, {
                    BackgroundTransparency = 1
                })
            end

        end)

