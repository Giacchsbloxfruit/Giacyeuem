									Size =
										UDim2.new(
											1,
											0,
											0,
											38
										)
								},
								0.17
							)

							Arrow.Rotation =
								0

						end

					end
				)

				function Dropdown:Set(values)

					Dropdown.Values = {}

					for _, value in ipairs(
						values or {}
					) do

						Dropdown.Values[value] =
							true

						if OptionButtons[value] then

							Tween(
								OptionButtons[value].Button,
								{
									BackgroundColor3 =
										Theme.White
								},
								0.1
							)

							Tween(
								OptionButtons[value].Text,
								{
									TextColor3 =
										Theme.Black
								},
								0.1
							)

						end

					end

					Refresh()

					Callback(
						config.Callback,
						Dropdown.Values
					)

				end

				return Store(
					Dropdown
				)

			end

