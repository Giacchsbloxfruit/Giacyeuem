                            BackgroundTransparency =
                                0.12,
                            BackgroundColor3 =
                                Theme.Card
                        },
                        0.12
                    )

                end

            end
        )

        TabButton.MouseLeave:Connect(
            function()

                if Window.CurrentTab ~= Tab then

                    Tween(
                        TabButton,
                        {
                            BackgroundTransparency =
                                1
                        },
                        0.12
                    )

                end

            end
        )

        TabButton.MouseButton1Click:Connect(
            function()

                Tab:Activate()

            end
        )

        --====================================================
        -- SECTION
        --====================================================

        function Tab:AddSection(Name)

            local Section = {}

            --================================================
            -- SECTION FRAME
            --================================================

            local Frame = Create("Frame", {

                Parent = Page,

                Size =
                    UDim2.new(
