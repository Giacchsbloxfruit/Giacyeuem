            Divider.Visible = false
            VersionLabel.Visible = false

            MenuButton.Visible = true

            for _, tab in pairs(Window.Tabs) do
                tab.Button.Size = UDim2.new(1,-8,0,42)
            end
        else
            Root.Size = UDim2.new(
                0,
                math.clamp(viewport.X * 0.64,760,1100),
                0,
                math.clamp(viewport.Y * 0.72,480,700)
            )

            Sidebar.Size = UDim2.fromScale(0.235,1)
            Sidebar.Visible = true

            Content.Size = UDim2.fromScale(0.765,1)
            Content.Position = UDim2.fromScale(0.235,0)

            PageContainer.Size = UDim2.new(1,-28,1,-28)
            PageContainer.Position = UDim2.new(0,14,0,14)

            MenuButton.Visible = false
        end
    end

