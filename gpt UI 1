        function Tab:Activate()
            for _, other in pairs(Window.Tabs) do
                other.Page.Visible = false

                Tween(
                    other.Button,
                    TweenInfo.new(0.15),
                    {
                        BackgroundTransparency = 1
                    }
                )

                other.Indicator.BackgroundTransparency = 1
                other.Dot.BackgroundColor3 = Theme.Muted
                other.Label.TextColor3 = Theme.SubText
            end

            Page.Visible = true

            Tween(
                Button,
                TweenInfo.new(
                    0.18,
                    Enum.EasingStyle.Quart,
                    Enum.EasingDirection.Out
                ),
                {
                    BackgroundTransparency = 0
                }
            )

            Button.BackgroundColor3 = Theme.Surface2

            Indicator.BackgroundTransparency = 0
            Dot.BackgroundColor3 = Theme.Text
            Label.TextColor3 = Theme.Text

            Window.CurrentTab = Tab

            MoveOrbs()

            if IsMobile() then
                Sidebar.Visible = false
            end
        end

        BindClick(Button,function()
            Tab:Activate()
        end)

        Window.Tabs[name] = Tab

        if not Window.CurrentTab then
            task.defer(function()
                Tab:Activate()
            end)
        end

