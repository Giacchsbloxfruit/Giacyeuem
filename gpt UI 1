        local viewport = Camera.ViewportSize

        if IsMobile() then
            Root.Size = UDim2.fromScale(0.94,0.84)
            Root.Position = UDim2.fromScale(0.5,0.5)

            Sidebar.Size = UDim2.fromScale(0.74,1)
