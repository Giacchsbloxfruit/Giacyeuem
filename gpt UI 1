				Tab.Sections,
				Section
			)

			return Section

		end

		Tab.TabButton =
			TabButton

		Tab.TabBackground =
			TabBackground

		Tab.Page =
			Page

		Tab.Icon =
			Icon

		Tab.TabText =
			TabText

		Tab.Indicator =
			Indicator

		Window.Tabs[name] =
			Tab

		table.insert(
			Window.TabOrder,
			Tab
		)

		UpdateTabCanvas()

		if not Window.CurrentTab then

			task.defer(
				function()

					if Tab.Page.Parent then
						Tab:Activate()
					end

				end
			)

		end

		return Tab

	end

	Window.AddTab =
		Window.AddTabs

	--========================================================
	-- OPEN ANIMATION
	--========================================================

	Shell.Size =
		UDim2.fromOffset(
			850,
			525
		)

	Tween(
		Shell,
		{
			Size =
				UDim2.fromOffset(
					WINDOW_WIDTH,
					WINDOW_HEIGHT
				)
		},
		0.32
	)

	return Window
end

return Axiom
