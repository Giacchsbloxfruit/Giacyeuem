	Tween(Shell, {
		Size = UDim2.fromOffset(WINDOW_WIDTH, WINDOW_HEIGHT)
	}, 0.3)

	Tween(Outer, {
		BackgroundTransparency = 0
	}, 0.3)

	return Window
end

return Axiom
