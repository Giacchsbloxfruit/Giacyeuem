        HeaderTitle.Text = text
    end

    function Window:SetVersion(text)
        VersionLabel.Text = "v" .. text
    end

    function Window:Destroy()
        ScreenGui:Destroy()
    end

    function Window:GetScreenGui()
        return ScreenGui
    end

    return setmetatable(Window, {
        __index = Window
    })
end

