							Dropdown.Values[Option] =
								not Dropdown.Values[Option]

							local selected =
								Dropdown.Values[Option]

							Tween(
								OptionButton,
								{
									BackgroundColor3 =
										selected
										and Theme.White
										or Theme.Card
								},
								0.1
							)

							Tween(
								OptionText,
								{
									TextColor3 =
										selected
										and Theme.Black
										or Theme.SubText
								},
								0.1
							)

							Refresh()

							Callback(
								config.Callback,
								Dropdown.Values
							)

						end
					)

				end

				Select.MouseButton1Click:Connect(
					function()

						Open =
							not Open

						if Open then

							local Visible =
								math.min(
									#(
										config.Options
										or {}
									),
									3
								)

							Tween(
								Holder,
								{
									Size =
										UDim2.new(
											1,
											0,
											0,
