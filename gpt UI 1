            Tween(
                knob,
                TweenInfo.new(0.16, Enum.EasingStyle.Quint),
                {
                    Position = value
                        and UDim2.new(1, -20, 0.5, -8)
                        or UDim2.new(0, 4, 0.5, -8),
                    BackgroundColor3 = value
                        and Theme.Background
                        or Theme.SubText
                }
            )

            if fire then
                callback(value)
            end
        end

        switch.MouseButton1Click:Connect(function()
            Set(not value, true)
        end)

        Set(value, false)

        return {
            Set = function(_, v)
                Set(v, true)
            end,
            Get = function()
                return value
            end
        }
    end

