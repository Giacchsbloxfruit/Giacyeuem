    function Window:Minimize()
        minimized = not minimized

        if minimized then
            normalSize = Main.Size

            Tween(Main, {
                Size = UDim2.new(
                    normalSize.X.Scale,
                    normalSize.X.Offset,
                    0,
                    54
                )
            }, 0.25):Play()
        else
            Tween(Main, {
                Size = normalSize
            }, 0.25):Play()
        end
    end

