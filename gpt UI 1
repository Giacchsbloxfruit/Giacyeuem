                    Position = UDim2.new(1, -10, 0.5, 0),
                    Size = UDim2.fromOffset(12, 12),
                    Font = Enum.Font.GothamBold,
                    Text = "⌄",
                    TextColor3 = Theme.Muted,
                    TextSize = 11,
                    ZIndex = 32
                }, MainButton)

                local List = New("Frame", {
                    BackgroundColor3 = Theme.Surface2,
                    BorderSizePixel = 0,
                    Position = UDim2.new(0, 0, 1, 5),
                    Size = UDim2.new(1, 0, 0, 0),
                    ClipsDescendants = true,
                    Visible = false,
                    ZIndex = 100
                }, Holder)

                Corner(List, 8)
                Stroke(List, Theme.StrokeLight, 1, 0.15)

                local ListLayout = New("UIListLayout", {
                    Padding = UDim.new(0, 2)
                }, List)

                local ListPadding = Padding(List, 5, 5, 5, 5)

                local open = false
                local current = default

                local function Rebuild()
                    for _, child in ipairs(List:GetChildren()) do
                        if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
                            child:Destroy()
                        end
                    end

                    for _, item in ipairs(values) do
                        local Option = New("TextButton", {
                            BackgroundColor3 = Theme.Surface,
                            BackgroundTransparency = 1,
                            BorderSizePixel = 0,
                            Size = UDim2.new(1, 0, 0, 30),
                            AutoButtonColor = false,
                            Font = Enum.Font.Gotham,
                            Text = tostring(item),
                            TextColor3 = item == current and Theme.White or Theme.SubText,
                            TextSize = 9,
                            ZIndex = 101
                        }, List)

                        Corner(Option, 6)

                        Option.MouseEnter:Connect(function()
                            Tween(Option, {
                                BackgroundTransparency = 0.15
                            }, 0.1):Play()
                        end)

                        Option.MouseLeave:Connect(function()
                            Tween(Option, {
                                BackgroundTransparency = 1
                            }, 0.1):Play()
                        end)

                        Option.MouseButton1Click:Connect(function()
                            current = item
                            Value.Text = tostring(item)
                            open = false
                            List.Visible = false
                            Arrow.Text = "⌄"

                            if callback then
                                task.spawn(callback, item)
                            end
                        end)
                    end

                    local count = math.min(#values, 6)
                    List.Size = UDim2.new(1, 0, 0, count * 32 + 10)
                end

                Rebuild()

                MainButton.MouseButton1Click:Connect(function()
                    open = not open
                    List.Visible = open
                    Arrow.Text = open and "⌃" or "⌄"

                    if open then
                        List.ZIndex = 100
                    end
                end)

                return {
                    Set = function(value)
                        if table.find(values, value) then
                            current = value
                            Value.Text = tostring(value)

                            if callback then
                                task.spawn(callback, value)
                            end
                        end
                    end,
                    Get = function()
                        return current
                    end,
                    Refresh = function(newValues)
                        values = newValues or {}
                        current = values[1] or "None"
                        Value.Text = tostring(current)
                        Rebuild()
                    end
                }
            end

