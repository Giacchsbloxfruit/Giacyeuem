local NotifContainer = nil
local function BuildNotifContainer()
    if NotifContainer and NotifContainer.Parent then return end
    local TargetGui = CoreGui:FindFirstChild("AuroraUI")
    if not TargetGui then
        TargetGui = Instance.new("ScreenGui", CoreGui)
        TargetGui.Name = "AuroraUI"
    end
    NotifContainer = Instance.new("Frame", TargetGui)
    NotifContainer.Size = UDim2.new(0, 280, 1, -20)
    NotifContainer.Position = UDim2.new(1, -290, 0, 10)
    NotifContainer.BackgroundTransparency = 1
    
    local Layout = Instance.new("UIListLayout", NotifContainer)
    Layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
    Layout.Padding = UDim.new(0, 8)
end

function AuroraLib:Notification(Config)
    BuildNotifContainer()
    
    local Title = Config.Title or "Thông Báo"
    local Text = Config.Text or "Nội dung thông báo..."
    local Duration = Config.Duration or 4
    
    local BoxWidth = 260
    local TitleHeight = TextService:GetTextSize(Title, 14, FontBold, Vector2.new(BoxWidth - 24, 1000)).Y
    local TextHeight = TextService:GetTextSize(Text, 13, FontMain, Vector2.new(BoxWidth - 24, 1000)).Y
    local TotalHeight = math.clamp(TitleHeight + TextHeight + 22, 54, 150)
    
    local NotifBox = Instance.new("Frame", NotifContainer)
    NotifBox.Size = UDim2.new(1, 0, 0, TotalHeight)
    NotifBox.BackgroundColor3 = Theme.Bg
    NotifBox.BackgroundTransparency = 0.15
    NotifBox.Position = UDim2.new(1, 40, 0, 0)
    NotifBox.ClipsDescendants = true
    Instance.new("UICorner", NotifBox).CornerRadius = UDim.new(0, 6)
    
    local NStroke = Instance.new("UIStroke", NotifBox)
    NStroke.Color = Theme.Accent
    NStroke.Transparency = 0.8
    
    local NTitle = Instance.new("TextLabel", NotifBox)
    NTitle.Size = UDim2.new(1, -24, 0, TitleHeight)
    NTitle.Position = UDim2.new(0, 12, 0, 8)
    NTitle.Text = Title
    NTitle.TextColor3 = Theme.Accent
    NTitle.Font = FontBold
    NTitle.TextSize = 14
    NTitle.TextXAlignment = Enum.TextXAlignment.Left
    NTitle.BackgroundTransparency = 1
    
    local NText = Instance.new("TextLabel", NotifBox)
    NText.Size = UDim2.new(1, -24, 0, TextHeight)
    NText.Position = UDim2.new(0, 12, 0, TitleHeight + 10)
    NText.Text = Text
    NText.TextColor3 = Theme.Text
    NText.Font = FontMain
    NText.TextSize = 13
    NText.TextXAlignment = Enum.TextXAlignment.Left
    NText.TextYAlignment = Enum.TextYAlignment.Top
    NText.BackgroundTransparency = 1
    NText.TextWrapped = true
    
    local ProgressBar = Instance.new("Frame", NotifBox)
    ProgressBar.Size = UDim2.new(1, 0, 0, 3)
    ProgressBar.Position = UDim2.new(0, 0, 1, -3)
    ProgressBar.BackgroundColor3 = Theme.Accent
    ProgressBar.BorderSizePixel = 0
    
    TweenService:Create(NotifBox, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, 0)}):Play()
    TweenService:Create(ProgressBar, TweenInfo.new(Duration, Enum.EasingStyle.Linear), {Size = UDim2.new(0, 0, 0, 3)}):Play()
    
    task.delay(Duration, function()
        local CloseTween = TweenService:Create(NotifBox, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Position = UDim2.new(1, 40, 0, 0)})
        CloseTween:Play()
        CloseTween.Completed:Connect(function()
            NotifBox:Destroy()
        end)
    end)
end

function AuroraLib:CreateWindow(Config)
    local MainTitleText = Config.Name or "Giacyeuem Hub"
    local SubTitleText = Config.SubName or "ver 1.0 by Giacdz Hub"

    if CoreGui:FindFirstChild("AuroraUI") then
        local OldGui = CoreGui.AuroraUI
        OldGui:Destroy()
    end

    local ScreenGui = Instance.new("ScreenGui", CoreGui)
    ScreenGui.Name = "AuroraUI"

    local MainFrame = Instance.new("Frame", ScreenGui)
    MainFrame.Size = UDim2.new(0, 620, 0, 420)
    MainFrame.Position = UDim2.new(0.5, -310, 0.5, -210)
    MainFrame.BackgroundColor3 = Theme.Bg
    MainFrame.BackgroundTransparency = 0.25
    MainFrame.ClipsDescendants = true 
    Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 8)
    
