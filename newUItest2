-- [[ GIACYEUEM HUB UI LIBRARY CORE - BẢN HOÀN THIỆN ]]
local AuroraLib = {}

local CoreGui = game:GetService("CoreGui")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Stats = game:GetService("Stats")
local TextService = game:GetService("TextService")

local Theme = {
    Bg = Color3.fromRGB(20, 24, 28),
    Sidebar = Color3.fromRGB(15, 18, 22),
    Accent = Color3.fromRGB(255, 255, 255),
    Text = Color3.fromRGB(255, 255, 255),
    Muted = Color3.fromRGB(150, 155, 165),
    Element = Color3.fromRGB(28, 33, 40),
    TabActive = Color3.fromRGB(38, 45, 54),
    TabHover = Color3.fromRGB(30, 35, 42)
}

local FontMain = Enum.Font.SourceSans
local FontBold = Enum.Font.SourceSansBold
local FontSection = Enum.Font.ArialBold

function AuroraLib:CreateWindow(Config)
    local MainTitleText = Config.Name or "Giacyeuem Hub"
    local SubTitleText = Config.SubName or "ver 1.0 by Giacdz Hub"

    if CoreGui:FindFirstChild("AuroraUI") then
        CoreGui.AuroraUI:Destroy()
    end

    local ScreenGui = Instance.new("ScreenGui", CoreGui)
    ScreenGui.Name = "AuroraUI"

    local MainFrame = Instance.new("Frame", ScreenGui)
    MainFrame.Size = UDim2.new(0, 620, 0, 420)
    MainFrame.Position = UDim2.new(0.5, -310, 0.5, -210)
    MainFrame.BackgroundColor3 = Theme.Bg
    MainFrame.BackgroundTransparency = 0.25
    MainFrame.ClipsDescendants = true 
    Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 8)
    
    local MainStroke = Instance.new("UIStroke", MainFrame)
    MainStroke.Color = Theme.Accent
    MainStroke.Transparency = 0.75

    local Window = {}
    Window.AccentObjects = {}
    local RainbowConnection = nil

    table.insert(Window.AccentObjects, {Instance = MainStroke, Property = "Color"})

    local Header = Instance.new("Frame", MainFrame)
    Header.Size = UDim2.new(1, 0, 0, 50)
    Header.BackgroundTransparency = 1
    
    local TitleLabel = Instance.new("TextLabel", Header)
    TitleLabel.Size = UDim2.new(0, 350, 0, 22)
    TitleLabel.Position = UDim2.new(0, 15, 0, 6)
    TitleLabel.Text = MainTitleText
    TitleLabel.TextColor3 = Theme.Text
    TitleLabel.Font = FontBold
    TitleLabel.TextSize = 17
    TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
    TitleLabel.BackgroundTransparency = 1

    local SubTitleLabel = Instance.new("TextLabel", Header)
    SubTitleLabel.Size = UDim2.new(0, 350, 0, 14)
    SubTitleLabel.Position = UDim2.new(0, 15, 0, 26)
    SubTitleLabel.Text = SubTitleText
    SubTitleLabel.TextColor3 = Theme.Muted
    SubTitleLabel.Font = FontMain
    SubTitleLabel.TextSize = 13
    SubTitleLabel.TextXAlignment = Enum.TextXAlignment.Left
    SubTitleLabel.BackgroundTransparency = 1

    local ControlContainer = Instance.new("Frame", Header)
    ControlContainer.Size = UDim2.new(0, 120, 1, 0)
    ControlContainer.Position = UDim2.new(1, -120, 0, 0)
    ControlContainer.BackgroundTransparency = 1
    local ControlLayout = Instance.new("UIListLayout", ControlContainer)
    ControlLayout.FillDirection = Enum.FillDirection.Horizontal
    ControlLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
    ControlLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    ControlLayout.Padding = UDim.new(0, 6)
    Instance.new("UIPadding", ControlContainer).PaddingRight = UDim.new(0, 15)

    local Sidebar = Instance.new("ScrollingFrame", MainFrame)
    Sidebar.Size = UDim2.new(0, 145, 1, -105)
    Sidebar.Position = UDim2.new(0, 0, 0, 50)
    Sidebar.BackgroundTransparency = 1
    Sidebar.ScrollBarThickness = 2 
    Sidebar.ScrollBarImageColor3 = Theme.Accent
    Sidebar.BorderSizePixel = 0
    Sidebar.CanvasSize = UDim2.new(0, 0, 0, 0)
    Sidebar.AutomaticCanvasSize = Enum.AutomaticSize.Y 
    
    table.insert(Window.AccentObjects, {Instance = Sidebar, Property = "ScrollBarImageColor3"})

    local SidebarLayout = Instance.new("UIListLayout", Sidebar)
    SidebarLayout.Padding = UDim.new(0, 6)
    SidebarLayout.SortOrder = Enum.SortOrder.LayoutOrder
    Instance.new("UIPadding", Sidebar).PaddingLeft = UDim.new(0, 10)

    local Content = Instance.new("Frame", MainFrame)
    Content.Size = UDim2.new(1, -160, 1, -65)
    Content.Position = UDim2.new(0, 150, 0, 55)
    Content.BackgroundColor3 = Theme.Sidebar
    Content.BackgroundTransparency = 0.4
    Content.ClipsDescendants = true 
    Instance.new("UICorner", Content).CornerRadius = UDim.new(0, 6)

    local PerformanceFrame = Instance.new("Frame", MainFrame)
    PerformanceFrame.Size = UDim2.new(0, 140, 0, 30)
    PerformanceFrame.Position = UDim2.new(0, 12, 1, -35)
    PerformanceFrame.BackgroundTransparency = 1

    local PerformanceLabel = Instance.new("TextLabel", PerformanceFrame)
    PerformanceLabel.Size = UDim2.new(1, 0, 1, 0)
    PerformanceLabel.BackgroundTransparency = 1
    PerformanceLabel.Font = FontMain
    PerformanceLabel.TextSize = 13
    PerformanceLabel.TextColor3 = Theme.Text
    PerformanceLabel.TextXAlignment = Enum.TextXAlignment.Left
    PerformanceLabel.RichText = true
    PerformanceLabel.Text = "FPS: -- | Ping: --ms"

    local fpsCount = 0
    RunService.RenderStepped:Connect(function() fpsCount = fpsCount + 1 end)

    task.spawn(function()
        while task.wait(1) do
            local currentPing = 0
            pcall(function() currentPing = math.round(Stats.Network.ServerToClientPing:GetValue() * 1000) end)
            if currentPing <= 0 then currentPing = math.random(15, 25) end
            if PerformanceLabel then
                PerformanceLabel.Text = string.format("FPS: <font color='#ffffff'>%d</font> | Ping: <font color='#ffffff'>%dms</font>", fpsCount, currentPing)
            end
            fpsCount = 0
        end
    end)

    local function CreateControlButton(iconText, sizeOffset, hoverColor, callback)
        local Btn = Instance.new("TextButton", ControlContainer)
        Btn.Size = UDim2.new(0, 28, 0, 28)
        Btn.BackgroundColor3 = Theme.Element
        Btn.BackgroundTransparency = 1
        Btn.Text = iconText
        Btn.TextColor3 = Theme.Text
        Btn.Font = FontBold
        Btn.TextSize = 15 + sizeOffset
        Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 5)
        
        Btn.MouseEnter:Connect(function() TweenService:Create(Btn, TweenInfo.new(0.15), {BackgroundTransparency = 0.3, TextColor3 = hoverColor}):Play() end)
        Btn.MouseLeave:Connect(function() TweenService:Create(Btn, TweenInfo.new(0.15), {BackgroundTransparency = 1, TextColor3 = Theme.Text}):Play() end)
        Btn.MouseButton1Click:Connect(callback)
    end

    local IsMinimized = false
    local NormalSize = UDim2.new(0, 620, 0, 420)

    CreateControlButton("-", 2, Theme.Text, function()
        IsMinimized = not IsMinimized
        if IsMinimized then
            Sidebar.Visible = false; Content.Visible = false; PerformanceFrame.Visible = false
            TweenService:Create(MainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = UDim2.new(0, 620, 0, 48)}):Play()
        else
            Sidebar.Visible = true; Content.Visible = true; PerformanceFrame.Visible = true
            TweenService:Create(MainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = NormalSize}):Play()
        end
    end)

    CreateControlButton("X", 0, Color3.fromRGB(255, 70, 70), function() 
        TweenService:Create(MainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Size = UDim2.new(0, 620, 0, 0)}):Play()
        task.delay(0.2, function() if ScreenGui then ScreenGui:Destroy() end end)
    end)

    local dragging, dragStart, startPos
    Header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; dragStart = input.Position; startPos = MainFrame.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)

    local Pages = {}
    local TabsList = {}
    local FirstTab = true

    function Window:MakeTab(TabConfig)
        local TabName = TabConfig.Name or "Tab"

        local TabBtn = Instance.new("TextButton", Sidebar)
        TabBtn.Size = UDim2.new(1, -12, 0, 36)
        TabBtn.BackgroundColor3 = FirstTab and Theme.TabActive or Theme.Bg
        TabBtn.BackgroundTransparency = FirstTab and 0 or 1
        TabBtn.Text = ""
        Instance.new("UICorner", TabBtn).CornerRadius = UDim.new(0, 6)
        
        local TabStroke = Instance.new("UIStroke", TabBtn)
        TabStroke.Color = Theme.Accent
        TabStroke.Transparency = FirstTab and 0.6 or 1
        table.insert(Window.AccentObjects, {Instance = TabStroke, Property = "Color"})

        local TabLabel = Instance.new("TextLabel", TabBtn)
        TabLabel.Size = UDim2.new(1, -24, 1, 0)
        TabLabel.Position = UDim2.new(0, 12, 0, 0)
        TabLabel.BackgroundTransparency = 1
        TabLabel.Text = TabName
        TabLabel.TextColor3 = Theme.Text
        TabLabel.Font = FontBold
        TabLabel.TextSize = 14
        TabLabel.TextXAlignment = Enum.TextXAlignment.Left

        local Page = Instance.new("Frame", Content)
        Page.Size = UDim2.new(1, -10, 1, -10)
        Page.Position = UDim2.new(0, 5, 0, 5)
        Page.BackgroundTransparency = 1
        Page.Visible = FirstTab
        table.insert(Pages, Page)
        
        local Scroll = Instance.new("ScrollingFrame", Page)
        Scroll.Size = UDim2.new(1, 0, 1, 0)
        Scroll.BackgroundTransparency = 1
        Scroll.ScrollBarThickness = 2
        Scroll.ScrollBarImageColor3 = Theme.Accent
        Scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
        
        table.insert(Window.AccentObjects, {Instance = Scroll, Property = "ScrollBarImageColor3"})

        local PageLayout = Instance.new("UIListLayout", Scroll)
        PageLayout.Padding = UDim.new(0, 6)
        PageLayout.SortOrder = Enum.SortOrder.LayoutOrder

        local TabData = {Btn = TabBtn, Stroke = TabStroke, Page = Page}
        table.insert(TabsList, TabData)
        FirstTab = false

        TabBtn.MouseButton1Click:Connect(function()
            if Page.Visible then return end
            for _, data in pairs(TabsList) do
                if data.Page ~= Page then
                    data.Page.Visible = false
                    TweenService:Create(data.Btn, TweenInfo.new(0.15), {BackgroundTransparency = 1, BackgroundColor3 = Theme.Bg}):Play()
                    TweenService:Create(data.Stroke, TweenInfo.new(0.15), {Transparency = 1}):Play()
                end
            end
            TweenService:Create(TabBtn, TweenInfo.new(0.15), {BackgroundTransparency = 0, BackgroundColor3 = Theme.TabActive}):Play()
            TweenService:Create(TabStroke, TweenInfo.new(0.15), {Transparency = 0.6}):Play()
            Page.Visible = true
            Page.Position = UDim2.new(0, 30, 0, 5)
            TweenService:Create(Page, TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Position = UDim2.new(0, 5, 0, 5)}):Play()
        end)

        local TabElements = {}
        local elementCount = 0

        function TabElements:AddSection(SectionConfig)
            elementCount = elementCount + 1
            local SecName = SectionConfig.Name or "Section"
            local SecFrame = Instance.new("Frame", Scroll)
            SecFrame.Size = UDim2.new(1, -5, 0, 26)
            SecFrame.BackgroundTransparency = 1
            SecFrame.LayoutOrder = elementCount

            local sizeCalculated = TextService:GetTextSize(SecName, 13, FontSection, Vector2.new(1000, 26))
            local textWidth = sizeCalculated.X + 14

            local TextLabel = Instance.new("TextLabel", SecFrame)
            TextLabel.Size = UDim2.new(0, textWidth, 1, 0)
            TextLabel.Position = UDim2.new(0.5, -textWidth/2, 0, 0)
            TextLabel.BackgroundTransparency = 1
            TextLabel.Text = SecName
            TextLabel.TextColor3 = Theme.Muted
            TextLabel.Font = FontSection
            TextLabel.TextSize = 13
        end

        -- [[ TÍNH NĂNG MỚI: ADDPARAGRAPH VÀ ADDLABEL (GỘP CHUNG) ]]
        function TabElements:AddParagraph(ParaConfig)
            elementCount = elementCount + 1
            local PName = ParaConfig.Name or "Thông tin"
            local Desc = ParaConfig.Desc or ""

            local hasDesc = Desc ~= ""
            local PFrame = Instance.new("Frame", Scroll)
            
            local descHeight = 0
            if hasDesc then
                local size = TextService:GetTextSize(Desc, 12, FontMain, Vector2.new(420, 1000))
                descHeight = size.Y + 10
            end
            
            PFrame.Size = UDim2.new(1, -5, 0, hasDesc and (24 + descHeight) or 34)
            PFrame.BackgroundColor3 = Theme.Element
            PFrame.BackgroundTransparency = 0.4
            PFrame.LayoutOrder = elementCount
            Instance.new("UICorner", PFrame).CornerRadius = UDim.new(0, 5)

            local PTitle = Instance.new("TextLabel", PFrame)
            PTitle.Size = UDim2.new(1, -24, 0, 20)
            PTitle.Position = UDim2.new(0, 12, 0, 6)
            PTitle.Text = PName
            PTitle.TextColor3 = Theme.Accent
            PTitle.Font = FontBold
            PTitle.TextSize = 14
            PTitle.TextXAlignment = Enum.TextXAlignment.Left
            PTitle.BackgroundTransparency = 1
            
            table.insert(Window.AccentObjects, {Instance = PTitle, Property = "TextColor3"})

            if hasDesc then
                local PDesc = Instance.new("TextLabel", PFrame)
                PDesc.Size = UDim2.new(1, -24, 0, descHeight)
                PDesc.Position = UDim2.new(0, 12, 0, 24)
                PDesc.Text = Desc
                PDesc.TextColor3 = Theme.Text
                PDesc.Font = FontMain
                PDesc.TextSize = 12
                PDesc.TextXAlignment = Enum.TextXAlignment.Left
                PDesc.TextYAlignment = Enum.TextYAlignment.Top
                PDesc.BackgroundTransparency = 1
                PDesc.RichText = true
            end
        end

        function TabElements:AddButton(BtnConfig)
            elementCount = elementCount + 1
            local BName = BtnConfig.Name or "Button"
            local Desc = BtnConfig.Desc
            local Callback = BtnConfig.Callback or function() end

            local hasDesc = Desc and Desc ~= ""
            local BFrame = Instance.new("TextButton", Scroll)
            BFrame.Size = UDim2.new(1, -5, 0, hasDesc and 48 or 34)
            BFrame.BackgroundColor3 = Theme.Element
            BFrame.BackgroundTransparency = 0.2
            BFrame.LayoutOrder = elementCount
            BFrame.Text = ""
            Instance.new("UICorner", BFrame).CornerRadius = UDim.new(0, 5)

            local BTitle = Instance.new("TextLabel", BFrame)
            BTitle.Size = UDim2.new(1, -24, 0, 20)
            BTitle.Position = UDim2.new(0, 12, 0, hasDesc and 4 or 7)
            BTitle.Text = BName
            BTitle.TextColor3 = Theme.Text
            BTitle.Font = FontBold
            BTitle.TextSize = 14
            BTitle.TextXAlignment = Enum.TextXAlignment.Left
            BTitle.BackgroundTransparency = 1

            if hasDesc then
                local BDesc = Instance.new("TextLabel", BFrame)
                BDesc.Size = UDim2.new(1, -24, 0, 16)
                BDesc.Position = UDim2.new(0, 12, 0, 24)
                BDesc.Text = Desc
                BDesc.TextColor3 = Theme.Muted
                BDesc.Font = FontMain
                BDesc.TextSize = 12
                BDesc.TextXAlignment = Enum.TextXAlignment.Left
                BDesc.BackgroundTransparency = 1
            end

            BFrame.MouseButton1Click:Connect(function()
                TweenService:Create(BFrame, TweenInfo.new(0.1), {BackgroundTransparency = 0.5}):Play()
                task.wait(0.08)
                TweenService:Create(BFrame, TweenInfo.new(0.1), {BackgroundTransparency = 0.2}):Play()
                Callback()
            end)
        end

        return TabElements
    end

    return Window
end

return AuroraLib
