local function FormatPrice(priceValue)
    local formatted = tostring(priceValue)
    repeat
        local k
        formatted, k = string.gsub(formatted, "^(-?%d+)(%d%d%d)", "%1,%2")
    until k == 0
    return formatted
end

local CommF = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("CommF_")

-- Hàm lấy chuỗi danh sách bằng tiếng Anh, viết hoa tiêu đề
local function GetFruitStockString()
    local stockText = "ADVANCE FRUIT STOCK\n"
    
    local status1, result1 = pcall(function()
        return CommF:InvokeServer("GetFruits", true)
    end)
    
    if not status1 or not result1 then
        stockText = stockText .. "  Error fetching advance stock data.\n"
    else
        local hasAdvance = false
        for _, fruit in pairs(result1) do
            if fruit.OnSale then
                hasAdvance = true
                stockText = stockText .. "  • " .. tostring(fruit.Name) .. " — $" .. FormatPrice(fruit.Price) .. "\n"
            end
        end
        if not hasAdvance then
            stockText = stockText .. "  No fruits currently on sale.\n"
        end
    end
    
    stockText = stockText .. "\nNORMAL FRUIT STOCK\n"
    
    local status2, result2 = pcall(function()
        return CommF:InvokeServer("GetFruits")
    end)
    
    if status2 and result2 then
        local hasNormal = false
        for _, fruit in pairs(result2) do
            if fruit.OnSale then
                hasNormal = true
                stockText = stockText .. "  • " .. tostring(fruit.Name) .. " — $" .. FormatPrice(fruit.Price) .. "\n"
            end
        end
        if not hasNormal then
            stockText = stockText .. "  No fruits currently on sale.\n"
        end
    else
        stockText = stockText .. "  Error fetching normal stock data.\n"
    end
    
    return stockText
end

