-- [[ AURORA UI LIBRARY CORE - V4 (WEB ICONS & ANIMATIONS) ]]
local AuroraLib = {}

local CoreGui = game:GetService("CoreGui")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Stats = game:GetService("Stats")

-- Cấu hình màu sắc
local Theme = {
    Bg = Color3.fromRGB(20, 24, 28),
    Sidebar = Color3.fromRGB(15, 18, 22),
    Accent = Color3.fromRGB(0, 230, 255),
    Text = Color3.fromRGB(245, 245, 245),
    Muted = Color3.fromRGB(140, 145, 155),
    Element = Color3.fromRGB(28, 33, 40)
}

-- HÀM LẤY ICON TỪ WEB (Giống Wind UI / Fluent)
local function GetWebIcon(iconName)
    if not iconName or iconName == "" then return "" end
    -- Đảm bảo executor hỗ trợ các hàm custom
    local getasset = getcustomasset or getsynasset
    if not getasset or not writefile or not isfile or not makefolder then return "" end

    local folderName = "Aurora_Icons"
    local filePath = folderName .. "/" .. iconName .. ".png"
    
    if not isfolder(folderName) then
        makefolder(folderName)
    end

    -- Nếu chưa có ảnh trong máy thì tải từ web về
    if not isfile(filePath) then
        -- Dùng nguồn icon của Fluent (rất đầy đủ Lucide icons)
        local url = "https://raw.githubusercontent.com/dawid-scripts/Fluent/master/src/Icons/" .. iconName .. ".png"
        pcall(function()
            local imgData = game:HttpGet(url)
            if imgData then
                writefile(filePath, imgData)
            end
        end)
    end

    if isfile(filePath) then
        return getasset(filePath)
    end
    return ""
end

function AuroraLib:CreateWindow(Config)
    local WindowName = Config.Name or "Aurora Hub"
    local HideKey = Config.HideKey or Enum.KeyCode.RightControl

    if CoreGui:FindFirstChild("AuroraUI") then
        CoreGui.AuroraUI:Destroy()
    end

    local ScreenGui = Instance.new("ScreenGui", CoreGui)
    ScreenGui.Name = "AuroraUI"

    -- Khung chính
    local MainFrame = Instance.new("Frame", ScreenGui)
    MainFrame.Size = UDim2.new(0, 620, 0, 420)
    MainFrame.Position = UDim2.new(0.5, -310, 0.5, -210)
    MainFrame.BackgroundColor3 = Theme.Bg
    MainFrame.BackgroundTransparency = 0.25
    MainFrame.ClipsDescendants = true -- Cần thiết để làm nút Thu nhỏ
    Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 8)
    Instance.new("UIStroke", MainFrame).Color = Color3.fromRGB(55, 60, 70)

    -- [[ HEADER & BỘ NÚT ĐIỀU KHIỂN ]]
    local Header = Instance.new("Frame", MainFrame)
    Header.Size = UDim2.new(1, 0, 0, 40)
    Header.BackgroundTransparency = 1
    
    local Title = Instance.new("TextLabel", Header)
    Title.Size = UDim2.new(0, 300, 1, 0)
    Title.Position = UDim2.new(0, 15, 0, 0)
    Title.Text = WindowName
    Title.RichText = true
    Title.TextColor3 = Theme.Text
    Title.Font = Enum.Font.GothamBold
    Title.TextSize = 14
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.BackgroundTransparency = 1

    -- Vùng chứa nút điều khiển (Góc phải)
    local ControlContainer = Instance.new("Frame", Header)
    ControlContainer.Size = UDim2.new(0, 100, 1, 0)
    ControlContainer.Position = UDim2.new(1, -100, 0, 0)
    ControlContainer.BackgroundTransparency = 1
    
    local ControlLayout = Instance.new("UIListLayout", ControlContainer)
    ControlLayout.FillDirection = Enum.FillDirection.Horizontal
    ControlLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
    ControlLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    ControlLayout.Padding = UDim.new(0, 5)
    
    local ControlPadding = Instance.new("UIPadding", ControlContainer)
    ControlPadding.PaddingRight = UDim.new(0, 15)

    -- Hàm tạo nút điều khiển
    local function CreateControlButton(iconText, color, hoverColor, callback)
        local Btn = Instance.new("TextButton", ControlContainer)
        Btn.Size = UDim2.new(0, 24, 0, 24)
        Btn.BackgroundColor3 = Theme.Element
        Btn.BackgroundTransparency = 1
        Btn.Text = iconText
        Btn.TextColor3 = color
        Btn.Font = Enum.Font.GothamBold
        Btn.TextSize = 14
        Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 4)
        
        Btn.MouseEnter:Connect(function() TweenService:Create(Btn, TweenInfo.new(0.2), {BackgroundTransparency = 0, TextColor3 = hoverColor}):Play() end)
        Btn.MouseLeave:Connect(function() TweenService:Create(Btn, TweenInfo.new(0.2), {BackgroundTransparency = 1, TextColor3 = color}):Play() end)
        Btn.MouseButton1Click:Connect(callback)
    end

    local IsMinimized = false
    local IsMaximized = false
    local NormalSize = UDim2.new(0, 620, 0, 420)
    local MaxSize = UDim2.new(0, 750, 0, 500)

    -- Nút Thu nhỏ (-)
    CreateControlButton("-", Theme.Muted, Theme.Text, function()
        IsMinimized = not IsMinimized
        local targetSize = IsMinimized and UDim2.new(0, 620, 0, 40) or (IsMaximized and MaxSize or NormalSize)
        TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = targetSize}):Play()
    end)

    -- Nút Phóng to (□)
    CreateControlButton("□", Theme.Muted, Theme.Text, function()
        if IsMinimized then return end -- Không cho phóng to khi đang thu nhỏ
        IsMaximized = not IsMaximized
        local targetSize = IsMaximized and MaxSize or NormalSize
        TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = targetSize}):Play()
    end)

    -- Nút Đóng (X)
    CreateControlButton("X", Theme.Muted, Color3.fromRGB(255, 60, 60), function()
        ScreenGui:Destroy()
    end)

    -- [[ KÉO THẢ UI & GIAO DIỆN CHÍNH ]]
    local dragging, dragInput, dragStart, startPos
    Header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; dragStart = input.Position; startPos = MainFrame.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)

    -- Sidebar & Content
    local Sidebar = Instance.new("Frame", MainFrame)
    Sidebar.Size = UDim2.new(0, 140, 1, -90)
    Sidebar.Position = UDim2.new(0, 0, 0, 40)
    Sidebar.BackgroundTransparency = 1
    local SidebarLayout = Instance.new("UIListLayout", Sidebar)
    SidebarLayout.Padding = UDim.new(0, 4)
    Instance.new("UIPadding", Sidebar).PaddingLeft = UDim.new(0, 10)

    local Content = Instance.new("Frame", MainFrame)
    Content.Size = UDim2.new(1, -155, 1, -55)
    Content.Position = UDim2.new(0, 145, 0, 45)
    Content.BackgroundColor3 = Theme.Sidebar
    Content.BackgroundTransparency = 0.4
    Instance.new("UICorner", Content).CornerRadius = UDim.new(0, 6)

    -- Tính năng Tab
    local Window = {}
    local Pages = {}
    local FirstTab = true

    function Window:MakeTab(TabConfig)
        local TabName = TabConfig.Name or "Tab"
        local IconName = TabConfig.Icon or "box" -- Mặc định là icon cái hộp

        local TabBtn = Instance.new("TextButton", Sidebar)
        TabBtn.Size = UDim2.new(1, 0, 0, 32)
        TabBtn.BackgroundTransparency = 1
        TabBtn.Text = ""

        local IconImg = Instance.new("ImageLabel", TabBtn)
        IconImg.Size = UDim2.new(0, 16, 0, 16)
        IconImg.Position = UDim2.new(0, 5, 0.5, -8)
        IconImg.BackgroundTransparency = 1
        IconImg.ImageColor3 = FirstTab and Theme.Accent or Theme.Muted
        
        -- Gọi hàm load icon từ Web bằng đa luồng (không gây lag UI)
        task.spawn(function()
            IconImg.Image = GetWebIcon(IconName)
        end)

        local TabLabel = Instance.new("TextLabel", TabBtn)
        TabLabel.Size = UDim2.new(1, -25, 1, 0)
        TabLabel.Position = UDim2.new(0, 26, 0, 0)
        TabLabel.BackgroundTransparency = 1
        TabLabel.Text = TabName
        TabLabel.TextColor3 = FirstTab and Theme.Accent or Theme.Muted
        TabLabel.Font = Enum.Font.GothamSemibold
        TabLabel.TextSize = 13
        TabLabel.TextXAlignment = Enum.TextXAlignment.Left

        -- Dùng CanvasGroup để có thể làm hiệu ứng Mờ dần (Fade)
        local Page = Instance.new("CanvasGroup", Content)
        Page.Size = UDim2.new(1, -10, 1, -10)
        Page.Position = UDim2.new(0, 5, 0, 5)
        Page.BackgroundTransparency = 1
        Page.Visible = FirstTab
        Page.GroupTransparency = FirstTab and 0 or 1
        table.insert(Pages, Page)

        local Scroll = Instance.new("ScrollingFrame", Page)
        Scroll.Size = UDim2.new(1, 0, 1, 0)
        Scroll.BackgroundTransparency = 1
        Scroll.ScrollBarThickness = 2
        Scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
        
        local PageLayout = Instance.new("UIListLayout", Scroll)
        PageLayout.Padding = UDim.new(0, 6)
        FirstTab = false

        -- [[ LOGIC HIỆU ỨNG CHUYỂN TAB CỰC MƯỢT ]]
        TabBtn.MouseButton1Click:Connect(function()
            -- Đổi màu chữ
            for _, v in pairs(Sidebar:GetChildren()) do
                if v:IsA("TextButton") then 
                    v.TextLabel.TextColor3 = Theme.Muted 
                    v.ImageLabel.ImageColor3 = Theme.Muted
                end
            end
            TabLabel.TextColor3 = Theme.Accent
            IconImg.ImageColor3 = Theme.Accent

            -- Hiệu ứng tắt Tab cũ
            for _, p in pairs(Pages) do
                if p.Visible and p ~= Page then
                    TweenService:Create(p, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {GroupTransparency = 1, Position = UDim2.new(0, -10, 0, 5)}):Play()
                    task.delay(0.15, function() p.Visible = false end)
                end
            end

            -- Hiệu ứng bật Tab mới (Trượt từ phải sang + Nổi lên)
            Page.Visible = true
            Page.Position = UDim2.new(0, 20, 0, 5) -- Dịch sang phải 1 chút
            Page.GroupTransparency = 1
            TweenService:Create(Page, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {GroupTransparency = 0, Position = UDim2.new(0, 5, 0, 5)}):Play()
        end)

        -- Kế thừa các hàm AddToggle, AddButton như cũ (Gắn vào Scroll)
        local TabElements = {}

        function TabElements:AddToggle(ToggleConfig)
            -- [Bỏ qua phần này cho gọn, bạn copy logic AddToggle, AddButton ở code V3 gắn vào là được]
            local TName = ToggleConfig.Name or "Toggle"
            local Default = ToggleConfig.Default or false
            local Callback = ToggleConfig.Callback or function() end

            local TFrame = Instance.new("Frame", Scroll)
            TFrame.Size = UDim2.new(1, -5, 0, 38)
            TFrame.BackgroundColor3 = Theme.Element
            TFrame.BackgroundTransparency = 0.2
            Instance.new("UICorner", TFrame).CornerRadius = UDim.new(0, 5)

            local TTitle = Instance.new("TextLabel", TFrame)
            TTitle.Size = UDim2.new(1, -60, 1, 0)
            TTitle.Position = UDim2.new(0, 12, 0, 0)
            TTitle.Text = TName
            TTitle.TextColor3 = Theme.Text
            TTitle.Font = Enum.Font.Gotham
            TTitle.TextSize = 13
            TTitle.TextXAlignment = Enum.TextXAlignment.Left
            TTitle.BackgroundTransparency = 1

            local SwitchBtn = Instance.new("TextButton", TFrame)
            SwitchBtn.Size = UDim2.new(0, 34, 0, 18)
            SwitchBtn.Position = UDim2.new(1, -45, 0.5, -9)
            SwitchBtn.BackgroundColor3 = Default and Theme.Accent or Color3.fromRGB(55, 60, 70)
            SwitchBtn.Text = ""
            Instance.new("UICorner", SwitchBtn).CornerRadius = UDim.new(1, 0)

            local Dot = Instance.new("Frame", SwitchBtn)
            Dot.Size = UDim2.new(0, 12, 0, 12)
            Dot.Position = Default and UDim2.new(1, -15, 0.5, -6) or UDim2.new(0, 3, 0.5, -6)
            Dot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            Instance.new("UICorner", Dot).CornerRadius = UDim.new(1, 0)

            local State = Default
            SwitchBtn.MouseButton1Click:Connect(function()
                State = not State
                local targetColor = State and Theme.Accent or Color3.fromRGB(55, 60, 70)
                local targetPos = State and UDim2.new(1, -15, 0.5, -6) or UDim2.new(0, 3, 0.5, -6)
                TweenService:Create(SwitchBtn, TweenInfo.new(0.2), {BackgroundColor3 = targetColor}):Play()
                TweenService:Create(Dot, TweenInfo.new(0.2), {Position = targetPos}):Play()
                Callback(State)
            end)
        end

        return TabElements
    end

    return Window
end

return AuroraLib
