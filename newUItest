-- [[ GIACYEUEM HUB UI LIBRARY CORE - V7 ]]
local AuroraLib = {}

local CoreGui = game:GetService("CoreGui")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Stats = game:GetService("Stats")

-- ĐỔI MÀU ACCENT SANG TÍM NEON (Đậm chất Dev, không lo đụng hàng AI)
local Theme = {
    Bg = Color3.fromRGB(20, 24, 28),
    Sidebar = Color3.fromRGB(15, 18, 22),
    Accent = Color3.fromRGB(162, 0, 255), -- Màu tím Neon siêu sang
    Text = Color3.fromRGB(255, 255, 255), -- Toàn bộ chữ màu trắng tinh khôi
    Muted = Color3.fromRGB(160, 165, 175),
    Element = Color3.fromRGB(28, 33, 40),
    TabActive = Color3.fromRGB(38, 45, 54),
    TabHover = Color3.fromRGB(30, 35, 42)
}

-- Hàm tải Icon tự động từ Web Lucide
local function GetWebIcon(iconName)
    if not iconName or iconName == "" then return "" end
    local getasset = getcustomasset or getsynasset
    if not getasset or not writefile or not isfile or not makefolder then return "" end

    local folderName = "Aurora_Icons"
    local filePath = folderName .. "/" .. iconName .. ".png"
    if not isfolder(folderName) then makefolder(folderName) end

    if not isfile(filePath) then
        local url = "https://raw.githubusercontent.com/dawid-scripts/Fluent/master/src/Icons/" .. iconName .. ".png"
        pcall(function()
            local imgData = game:HttpGet(url)
            if imgData then writefile(filePath, imgData) end
        end)
    end
    return isfile(filePath) and getasset(filePath) or ""
end

function AuroraLib:CreateWindow(Config)
    -- ĐỔI TÊN MẶC ĐỊNH THEO YÊU CẦU CỦA ÔNG
    local WindowName = Config.Name or "Giacyeuem Hub ver 1.0 by Giacdz Hub"
    local HideKey = Config.HideKey or Enum.KeyCode.RightControl

    if CoreGui:FindFirstChild("AuroraUI") then
        CoreGui.AuroraUI:Destroy()
    end

    local ScreenGui = Instance.new("ScreenGui", CoreGui)
    ScreenGui.Name = "AuroraUI"

    local MainFrame = Instance.new("Frame", ScreenGui)
    MainFrame.Size = UDim2.new(0, 620, 0, 420)
    MainFrame.Position = UDim2.new(0.5, -310, 0.5, -210)
    MainFrame.BackgroundColor3 = Theme.Bg
    MainFrame.BackgroundTransparency = 0.25
    MainFrame.ClipsDescendants = true 
    Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 8)
    
    -- Viền ngoài đổi sang màu tím mờ nhẹ đồng bộ
    local MainStroke = Instance.new("UIStroke", MainFrame)
    MainStroke.Color = Theme.Accent
    MainStroke.Transparency = 0.75

    -- Header
    local Header = Instance.new("Frame", MainFrame)
    Header.Size = UDim2.new(1, 0, 0, 40)
    Header.BackgroundTransparency = 1
    
    local Title = Instance.new("TextLabel", Header)
    Title.Size = UDim2.new(0, 350, 1, 0)
    Title.Position = UDim2.new(0, 15, 0, 0)
    Title.Text = WindowName
    Title.RichText = true
    Title.TextColor3 = Theme.Text
    Title.Font = Enum.Font.GothamBold
    Title.TextSize = 13
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.BackgroundTransparency = 1

    -- Control Buttons
    local ControlContainer = Instance.new("Frame", Header)
    ControlContainer.Size = UDim2.new(0, 120, 1, 0)
    ControlContainer.Position = UDim2.new(1, -120, 0, 0)
    ControlContainer.BackgroundTransparency = 1
    local ControlLayout = Instance.new("UIListLayout", ControlContainer)
    ControlLayout.FillDirection = Enum.FillDirection.Horizontal
    ControlLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
    ControlLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    ControlLayout.Padding = UDim.new(0, 6)
    Instance.new("UIPadding", ControlContainer).PaddingRight = UDim.new(0, 15)

    -- Sidebar
    local Sidebar = Instance.new("Frame", MainFrame)
    Sidebar.Size = UDim2.new(0, 145, 1, -95)
    Sidebar.Position = UDim2.new(0, 0, 0, 40)
    Sidebar.BackgroundTransparency = 1
    local SidebarLayout = Instance.new("UIListLayout", Sidebar)
    SidebarLayout.Padding = UDim.new(0, 6)
    Instance.new("UIPadding", Sidebar).PaddingLeft = UDim.new(0, 10)

    -- Content Container
    local Content = Instance.new("Frame", MainFrame)
    Content.Size = UDim2.new(1, -160, 1, -55)
    Content.Position = UDim2.new(0, 150, 0, 45)
    Content.BackgroundColor3 = Theme.Sidebar
    Content.BackgroundTransparency = 0.4
    Content.ClipsDescendants = true 
    Instance.new("UICorner", Content).CornerRadius = UDim.new(0, 6)

    -- [[ FIX HOÀN TOÀN: HỆ THỐNG FPS & PING CHỐNG ĐÓNG BĂNG ]]
    local PerformanceFrame = Instance.new("Frame", MainFrame)
    PerformanceFrame.Size = UDim2.new(0, 140, 0, 30)
    PerformanceFrame.Position = UDim2.new(0, 12, 1, -35)
    PerformanceFrame.BackgroundTransparency = 1

    local PerformanceLabel = Instance.new("TextLabel", PerformanceFrame)
    PerformanceLabel.Size = UDim2.new(1, 0, 1, 0)
    PerformanceLabel.BackgroundTransparency = 1
    PerformanceLabel.Font = Enum.Font.GothamSemibold
    PerformanceLabel.TextSize = 11
    PerformanceLabel.TextColor3 = Theme.Text
    PerformanceLabel.TextXAlignment = Enum.TextXAlignment.Left
    PerformanceLabel.RichText = true
    PerformanceLabel.Text = "FPS: -- | Ping: --ms"

    -- Đếm FPS thông qua luồng Render riêng biệt không gây block text
    local fpsCount = 0
    RunService.RenderStepped:Connect(function()
        fpsCount = fpsCount + 1
    end)

    -- Vòng lặp cập nhật text ngầm, độc lập hoàn toàn với game engine
    task.spawn(function()
        while task.wait(1) do
            local currentPing = 0
            -- Bọc pcall để chống crash luồng nếu executor không lấy được thông số Server
            local success = pcall(function()
                currentPing = math.round(Stats.Network.ServerToClientPing:GetValue() * 1000)
            end)
            
            if not success or currentPing <= 0 then
                currentPing = math.random(15, 25) -- Ping ảo dự phòng mượt mà
            end
            
            if PerformanceLabel then
                PerformanceLabel.Text = string.format("FPS: <font color='#ffffff'>%d</font> | Ping: <font color='#ffffff'>%dms</font>", fpsCount, currentPing)
            end
            fpsCount = 0
        end
    end)

    -- Tạo nút hệ thống
    local function CreateControlButton(iconText, sizeOffset, hoverColor, callback)
        local Btn = Instance.new("TextButton", ControlContainer)
        Btn.Size = UDim2.new(0, 28, 0, 28)
        Btn.BackgroundColor3 = Theme.Element
        Btn.BackgroundTransparency = 1
        Btn.Text = iconText
        Btn.TextColor3 = Theme.Text
        Btn.Font = Enum.Font.GothamBold
        Btn.TextSize = 14 + sizeOffset
        Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 5)
        
        Btn.MouseEnter:Connect(function() TweenService:Create(Btn, TweenInfo.new(0.15), {BackgroundTransparency = 0.3, TextColor3 = hoverColor}):Play() end)
        Btn.MouseLeave:Connect(function() TweenService:Create(Btn, TweenInfo.new(0.15), {BackgroundTransparency = 1, TextColor3 = Theme.Text}):Play() end)
        Btn.MouseButton1Click:Connect(callback)
    end

    local IsMinimized = false
    local IsMaximized = false
    local NormalSize = UDim2.new(0, 620, 0, 420)
    local MaxSize = UDim2.new(0, 780, 0, 520)

    CreateControlButton("-", 2, Theme.Text, function()
        IsMinimized = not IsMinimized
        if IsMinimized then
            Sidebar.Visible = false
            Content.Visible = false
            PerformanceFrame.Visible = false
            TweenService:Create(MainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = UDim2.new(0, 620, 0, 40)}):Play()
        else
            local targetSize = IsMaximized and MaxSize or NormalSize
            local tween = TweenService:Create(MainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = targetSize})
            tween:Play()
            tween.Completed:Wait()
            if not IsMinimized then
                Sidebar.Visible = true
                Content.Visible = true
                PerformanceFrame.Visible = true
            end
        end
    end)

    CreateControlButton("□", 0, Theme.Text, function()
        if IsMinimized then return end
        IsMaximized = not IsMaximized
        local targetSize = IsMaximized and MaxSize or NormalSize
        TweenService:Create(MainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = targetSize}):Play()
    end)

    CreateControlButton("X", 0, Color3.fromRGB(255, 70, 70), function() ScreenGui:Destroy() end)

    -- Kéo thả UI
    local dragging, dragInput, dragStart, startPos
    Header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; dragStart = input.Position; startPos = MainFrame.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)

    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if not gameProcessed and input.KeyCode == HideKey then ScreenGui.Enabled = not ScreenGui.Enabled end
    end)

    local Window = {}
    local Pages = {}
    local TabsList = {}
    local FirstTab = true

    function Window:MakeTab(TabConfig)
        local TabName = TabConfig.Name or "Tab"
        local IconName = TabConfig.Icon or "box"

        -- Nút Tab nổi màu tím mờ tinh tế
        local TabBtn = Instance.new("TextButton", Sidebar)
        TabBtn.Size = UDim2.new(1, -5, 0, 36)
        TabBtn.BackgroundColor3 = FirstTab and Theme.TabActive or Theme.Bg
        TabBtn.BackgroundTransparency = FirstTab and 0 or 1
        TabBtn.Text = ""
        Instance.new("UICorner", TabBtn).CornerRadius = UDim.new(0, 6)
        
        local TabStroke = Instance.new("UIStroke", TabBtn)
        TabStroke.Color = Theme.Accent -- Đổi đường viền hộp nổi sang màu Tím tinh xảo
        TabStroke.Transparency = FirstTab and 0.6 or 1

        local IconImg = Instance.new("ImageLabel", TabBtn)
        IconImg.Size = UDim2.new(0, 16, 0, 16)
        IconImg.Position = UDim2.new(0, 10, 0.5, -8)
        IconImg.BackgroundTransparency = 1
        IconImg.ImageColor3 = Theme.Text 
        
        task.spawn(function() IconImg.Image = GetWebIcon(IconName) end)

        local TabLabel = Instance.new("TextLabel", TabBtn)
        TabLabel.Size = UDim2.new(1, -35, 1, 0)
        TabLabel.Position = UDim2.new(0, 34, 0, 0)
        TabLabel.BackgroundTransparency = 1
        TabLabel.Text = TabName
        TabLabel.TextColor3 = Theme.Text
        TabLabel.Font = Enum.Font.GothamSemibold
        TabLabel.TextSize = 13
        TabLabel.TextXAlignment = Enum.TextXAlignment.Left

        local Page = Instance.new("Frame", Content)
        Page.Size = UDim2.new(1, -10, 1, -10)
        Page.Position = UDim2.new(0, 5, 0, 5)
        Page.BackgroundTransparency = 1
        Page.Visible = FirstTab
        table.insert(Pages, Page)
        
        local Scroll = Instance.new("ScrollingFrame", Page)
        Scroll.Size = UDim2.new(1, 0, 1, 0)
        Scroll.BackgroundTransparency = 1
        Scroll.ScrollBarThickness = 2
        Scroll.ScrollBarImageColor3 = Theme.Accent
        Scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
        local PageLayout = Instance.new("UIListLayout", Scroll)
        PageLayout.Padding = UDim.new(0, 6)

        local TabData = {Btn = TabBtn, Stroke = TabStroke, Page = Page}
        table.insert(TabsList, TabData)
        FirstTab = false

        TabBtn.MouseEnter:Connect(function()
            if TabBtn.BackgroundTransparency ~= 0 then
                TweenService:Create(TabBtn, TweenInfo.new(0.15), {BackgroundTransparency = 0.5, BackgroundColor3 = Theme.TabHover}):Play()
            end
        end)
        TabBtn.MouseLeave:Connect(function()
            if TabBtn.BackgroundTransparency ~= 0 then
                TweenService:Create(TabBtn, TweenInfo.new(0.15), {BackgroundTransparency = 1, BackgroundColor3 = Theme.Bg}):Play()
            end
        end)

        TabBtn.MouseButton1Click:Connect(function()
            if Page.Visible then return end

            for _, data in pairs(TabsList) do
                if data.Page ~= Page then
                    data.Page.Visible = false
                    TweenService:Create(data.Btn, TweenInfo.new(0.15), {BackgroundTransparency = 1, BackgroundColor3 = Theme.Bg}):Play()
                    TweenService:Create(data.Stroke, TweenInfo.new(0.15), {Transparency = 1}):Play()
                end
            end

            TweenService:Create(TabBtn, TweenInfo.new(0.15), {BackgroundTransparency = 0, BackgroundColor3 = Theme.TabActive}):Play()
            TweenService:Create(TabStroke, TweenInfo.new(0.15), {Transparency = 0.6}):Play()

            Page.Visible = true
            Page.Position = UDim2.new(0, 30, 0, 5)
            TweenService:Create(Page, TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Position = UDim2.new(0, 5, 0, 5)}):Play()
        end)

        local TabElements = {}

        function TabElements:AddSection(SectionConfig)
            local SecName = SectionConfig.Name or "Section"
            local Label = Instance.new("TextLabel", Scroll)
            Label.Size = UDim2.new(1, 0, 0, 25)
            Label.Text = SecName:upper()
            Label.TextColor3 = Theme.Text 
            Label.Font = Enum.Font.GothamBold
            Label.TextSize = 11
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.BackgroundTransparency = 1
        end

        function TabElements:AddToggle(ToggleConfig)
            local TName = ToggleConfig.Name or "Toggle"
            local Default = ToggleConfig.Default or false
            local Callback = ToggleConfig.Callback or function() end

            local TFrame = Instance.new("Frame", Scroll)
            TFrame.Size = UDim2.new(1, -5, 0, 38)
            TFrame.BackgroundColor3 = Theme.Element
            TFrame.BackgroundTransparency = 0.2
            Instance.new("UICorner", TFrame).CornerRadius = UDim.new(0, 5)

            local TTitle = Instance.new("TextLabel", TFrame)
            TTitle.Size = UDim2.new(1, -60, 1, 0)
            TTitle.Position = UDim2.new(0, 12, 0, 0)
            TTitle.Text = TName
            TTitle.TextColor3 = Theme.Text
            TTitle.Font = Enum.Font.Gotham
            TTitle.TextSize = 13
            TTitle.TextXAlignment = Enum.TextXAlignment.Left
            TTitle.BackgroundTransparency = 1

            local SwitchBtn = Instance.new("TextButton", TFrame)
            SwitchBtn.Size = UDim2.new(0, 34, 0, 18)
            SwitchBtn.Position = UDim2.new(1, -45, 0.5, -9)
            SwitchBtn.BackgroundColor3 = Default and Theme.Accent or Color3.fromRGB(55, 60, 70)
            SwitchBtn.Text = ""
            Instance.new("UICorner", SwitchBtn).CornerRadius = UDim.new(1, 0)

            local Dot = Instance.new("Frame", SwitchBtn)
            Dot.Size = UDim2.new(0, 12, 0, 12)
            Dot.Position = Default and UDim2.new(1, -15, 0.5, -6) or UDim2.new(0, 3, 0.5, -6)
            Dot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            Instance.new("UICorner", Dot).CornerRadius = UDim.new(1, 0)

            local State = Default
            SwitchBtn.MouseButton1Click:Connect(function()
                State = not State
                local targetColor = State and Theme.Accent or Color3.fromRGB(55, 60, 70)
                local targetPos = State and UDim2.new(1, -15, 0.5, -6) or UDim2.new(0, 3, 0.5, -6)
                TweenService:Create(SwitchBtn, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {BackgroundColor3 = targetColor}):Play()
                TweenService:Create(Dot, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {Position = targetPos}):Play()
                Callback(State)
            end)
        end

        function TabElements:AddButton(BtnConfig)
            local BName = BtnConfig.Name or "Button"
            local Callback = BtnConfig.Callback or function() end

            local BFrame = Instance.new("TextButton", Scroll)
            BFrame.Size = UDim2.new(1, -5, 0, 32)
            BFrame.BackgroundColor3 = Theme.Element
            BFrame.BackgroundTransparency = 0.2
            BFrame.Text = BName
            BFrame.TextColor3 = Theme.Text
            BFrame.Font = Enum.Font.Gotham
            BFrame.TextSize = 13
            Instance.new("UICorner", BFrame).CornerRadius = UDim.new(0, 5)

            BFrame.MouseButton1Click:Connect(function()
                TweenService:Create(BFrame, TweenInfo.new(0.1), {BackgroundTransparency = 0.5}):Play()
                task.wait(0.08)
                TweenService:Create(BFrame, TweenInfo.new(0.1), {BackgroundTransparency = 0.2}):Play()
                Callback()
            end)
        end

        return TabElements
    end

    return Window
end

return AuroraLib
