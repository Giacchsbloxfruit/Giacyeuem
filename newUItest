-- DROPDOWN GỘP CHUNG MÀU TĨNH VÀ RAINBOW
Tabs.Setting:AddDropdown({
    Name = "Đổi màu giao diện",
    -- Thêm "Rainbow" vào cuối danh sách
    Options = {"Trắng", "Đỏ", "Cam", "Vàng", "Xanh lá", "Xanh dương", "Tím", "Hồng", "Rainbow"},
    Default = "Trắng",
    Callback = function(colorName)
        -- 1. Việc đầu tiên: Tắt chế độ Rainbow nếu nó đang chạy để tránh lỗi chồng chéo
        if RainbowConnection then
            RainbowConnection:Disconnect()
            RainbowConnection = nil
        end

        -- 2. Kiểm tra xem người chơi chọn gì
        if colorName == "Rainbow" then
            -- Nếu chọn Rainbow thì bật vòng lặp nháy màu
            local hue = 0
            RainbowConnection = RunService.RenderStepped:Connect(function(deltaTime)
                hue = hue + (deltaTime * 0.15) -- 0.15 là tốc độ nháy
                if hue > 1 then hue = 0 end
                Window:ChangeThemeColor(Color3.fromHSV(hue, 1, 1))
            end)
        elseif ThemeColors[colorName] then
            -- Nếu chọn màu bình thường thì đổi thẳng sang màu đó
            Window:ChangeThemeColor(ThemeColors[colorName])
        end
    end
})
