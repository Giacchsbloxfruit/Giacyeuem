-- Hàm Gom Quái (Bring Mob) - Tầm 2-4 con gần nhất
local plr = game.Players.LocalPlayer
local WS = game:GetService("Workspace")

function BringMob(MobName, BringPos)
    if not _G.BringMob or not BringPos then return end
    
    local myChar = plr.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    
    local enemiesFolder = WS:FindFirstChild("Enemies")
    if not enemiesFolder then return end

    pcall(function()
        if sethiddenproperty then
            sethiddenproperty(plr, "SimulationRadius", math.huge)
        end
    end)

    local enemyCount = 0
    local firstEnemyRoot = nil 

    for _, mob in pairs(enemiesFolder:GetChildren()) do
        pcall(function()
            if mob.Name == MobName and mob:FindFirstChild("Humanoid") and mob.Humanoid.Health > 0 then
                local root = mob:FindFirstChild("HumanoidRootPart")
                if root then
                    local distanceToPlayer = (root.Position - myRoot.Position).Magnitude
                    if distanceToPlayer <= 350 then
                        enemyCount = enemyCount + 1
                        if not firstEnemyRoot then firstEnemyRoot = root end
                        
                        -- TẠO TỌA ĐỘ VÀ KHÓA HƯỚNG (ĐỨNG THẲNG)
                        local jitter = Vector3.new(math.random(-10,10)/1000, 0, math.random(-10,10)/1000)
                        local targetPosition = (BringPos * CFrame.new(enemyCount * 1.8, 0, 0)).Position + jitter
                        local targetCFrame = CFrame.new(targetPosition)

                        -- HIỆU ỨNG BAY NHANH CHẬM DẦN MƯỢT MÀ
                        local distanceToTarget = (root.Position - targetPosition).Magnitude
                        local glideSpeed = 0.08
                        if distanceToTarget < 15 then
                            glideSpeed = 0.3
                        end

                        local smoothedCFrame = root.CFrame:Lerp(targetCFrame, glideSpeed)

                        -- KHÓA VẬT LÝ BẰNG BODYMOVERS
                        root.Velocity = Vector3.zero
                        root.RotVelocity = Vector3.zero
                        
                        local bp = root:FindFirstChild("PosLock")
                        if not bp then
                            bp = Instance.new("BodyPosition")
                            bp.Name = "PosLock"
                            bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                            bp.P = 25000 
                            bp.D = 1200
                            bp.Parent = root
                        end
                        
                        local bg = root:FindFirstChild("GyroLock")
                        if not bg then
                            bg = Instance.new("BodyGyro")
                            bg.Name = "GyroLock"
                            bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                            bg.P = 20000
                            bg.Parent = root
                        end
                        
                        bp.Position = smoothedCFrame.Position
                        bg.CFrame = targetCFrame -- Ép quái luôn nhìn thẳng, không cắm đầu
                        root.CFrame = smoothedCFrame 

                        -- TẮT VA CHẠM XUYÊN TƯỜNG (Cực kỳ quan trọng ở Tàu Ma)
                        for _, part in pairs(mob:GetChildren()) do
                            if part:IsA("BasePart") then
                                part.CanCollide = false
                            end
                        end

                        -- [PHẦN CỐT LÕI FIX QUÁI ẢO TÀU MA]: Ép State 11 (StrafingNoPhysics)
                        -- Lệnh này nói với Server rằng: "Hãy bỏ qua mọi quy tắc kẹt tường, rơi tự do hay pathfinding của con quái này"
                        if mob.Humanoid:GetState() ~= Enum.HumanoidStateType.StrafingNoPhysics then
                            mob.Humanoid:ChangeState(11)
                        end
                    end
                end
            end
        end)
    end

    -- Chốt chặn cuối: Giữ tiêu điểm mạng
    if firstEnemyRoot then
        pcall(function()
            plr.ReplicationFocus = firstEnemyRoot
        end)
    end
end
