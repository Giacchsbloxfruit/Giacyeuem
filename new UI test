    local player = game.Players.LocalPlayer

    pcall(function()
        -- TÌM QUÁI GẦN NHẤT (Giống logic loop bone nhưng thêm so sánh khoảng cách)
        for _, v in pairs(enemies) do
            if v:FindFirstChild("Humanoid") and v:FindFirstChild("HumanoidRootPart") and v.Humanoid.Health > 0 then
                local dist = (player.Character.HumanoidRootPart.Position - v.HumanoidRootPart.Position).Magnitude
                if dist < minDist then
                    minDist = dist
                    targetMob = v
                end
            end
        end

        -- LOGIC XỬ LÝ KHI CÓ QUÁI
        if targetMob then
            -- 1. Trang bị vũ khí
            EquipWeapon(_G.SelectWeapon)

            -- 2. Bay đến trên đầu quái mục tiêu (giống loop bone dùng 25 unit)
            local targetCF = targetMob.HumanoidRootPart.CFrame * CFrame.new(0, 25, 0)
            topos(targetCF)

            -- 3. GỌI BRING MOB (Dựa trên tên và tọa độ con gần nhất)
            if _G.BringMob then
                BringMob(targetMob.Name, targetMob.HumanoidRootPart.CFrame)
            end

            -- 4. TẤN CÔNG (Dùng VirtualUser như loop bone của bạn)
            game:GetService("VirtualUser"):CaptureController()
            game:GetService("VirtualUser"):Button1Down(Vector2.new(1280, 672))

            -- 5. FIX LỖI PHÓNG TO & KHÓA QUÁI
            targetMob.HumanoidRootPart.CanCollide = false
            targetMob.Humanoid.WalkSpeed = 0
            if targetMob.HumanoidRootPart.Size ~= Vector3.new(2, 2, 1) then
                targetMob.HumanoidRootPart.Size = Vector3.new(2, 2, 1)
            end
        end
    end)
end

