--Loop farmlv
task.spawn(function()
    while task.wait() do
        if _G.AutoFarmLevel then
            pcall(function()
                local player = game.Players.LocalPlayer
                local char = player.Character
                local root = char:WaitForChild("HumanoidRootPart")
                local currentLevel = player.Data.Level.Value
                
                -- [ƯU TIÊN 1]: LOGIC DI CHUYỂN XUỐNG ĐẢO NƯỚC AN TOÀN
                if currentLevel >= 2600 and not IsAtSubmerged() then
                    local distToNPC = (root.Position - TikiPos.Position).Magnitude
                    
                    if distToNPC > 10 then
                        -- 1. Bay đến NPC thợ tàu
                        topos(TikiPos)
                    else
                        -- 2. Tới nơi thì thực hiện quy trình Teleport an toàn
                        StopTween()
                        root.CFrame = TikiPos
                        task.wait(0.5)
                        
                        -- Gọi lệnh chuyển cảnh (Đường dẫn chuẩn Modules.Net)
                        pcall(function()
                            local remote = game:GetService("ReplicatedStorage").Modules.Net["RF/SubmarineWorkerSpeak"]
                            remote:InvokeServer("TravelToSubmergedIsland")
                        end)
                        
                        -- Đợi 1 giây để game bắt đầu dịch chuyển
                        task.wait(1)

                        -- 3. TẠO VÙNG AN TOÀN TRÊN CAO ĐỂ ĐỢI LOAD
                        print("Đang tạo vùng an toàn trên không để đợi load đảo (10s)...")
                        local platform = Instance.new("Part")
                        platform.Size = Vector3.new(30, 1, 30)
                        platform.CFrame = root.CFrame * CFrame.new(0, 50, 0) -- Cao hơn 50m
                        platform.Anchored = true
                        platform.BrickColor = BrickColor.new("Cyan")
                        platform.Transparency = 0.5
                        platform.Parent = workspace
                        
                        root.CFrame = platform.CFrame * CFrame.new(0, 3, 0)
                        root.Anchored = true 

                        -- Vòng lặp chờ 10 giây
                        for i = 10, 1, -1 do
                            print("Đang đợi map load... còn " .. i .. " giây")
                            task.wait(1)
                        end
                        
                        -- 4. THẢ XUỐNG
                        root.Anchored = false
                        platform:Destroy()
                        root.CFrame = root.CFrame * CFrame.new(0, -50, 0)
                        print("Đã thả! Bắt đầu farm tại đảo mới.")
                    end
                    return -- Dừng loop tại đây để không chạy logic farm bên dưới khi đang tele
                end

                -- [ƯU TIÊN 2]: LOGIC FARM LEVEL BÌNH THƯỜNG
                local questData = GetMobByLevel(currentLevel)
                if questData then
                    local questGui = player.PlayerGui.Main.Quest
                    local hasQuest = questGui.Visible
                    local currentQuestText = hasQuest and questGui.Container.QuestTitle.Title.Text or ""
                    
                    -- KIỂM TRA & NHẬN NHIỆM VỤ
                    if not hasQuest or not string.find(currentQuestText, questData.Mon) then
                        if hasQuest then
                            game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("AbandonQuest")
                        end
                        
                        if (root.Position - questData.PosQ.Position).Magnitude > 10 then
                            topos(questData.PosQ)
                        else
                            game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("StartQuest", questData.Qname, questData.Qdata)
                        end
                    else
                        -- ĐÃ CÓ QUEST -> ĐI FARM QUÁI
                        local enemies = game:GetService("Workspace").Enemies
                        local targetMob = nil
                        
                        for _, mob in ipairs(enemies:GetChildren()) do
                            if mob.Name == questData.Mon and mob:FindFirstChild("Humanoid") and mob.Humanoid.Health > 0 then
                                targetMob = mob
                                break
                            end
                        end
                        
                        if targetMob then
                            EquipWeapon(_G.SelectWeapon)
                            topos(targetMob.HumanoidRootPart.CFrame * CFrame.new(0, 30, 0))
                            game:GetService("VirtualUser"):Button1Down(Vector2.new(1280, 670))
                            
                            if _G.BringMob then
                                for _, otherMob in ipairs(enemies:GetChildren()) do
                                    if otherMob.Name == questData.Mon and otherMob:FindFirstChild("Humanoid") and otherMob.Humanoid.Health > 0 then
                                        if (otherMob.HumanoidRootPart.Position - targetMob.HumanoidRootPart.Position).Magnitude < 250 then
                                            otherMob.HumanoidRootPart.CFrame = targetMob.HumanoidRootPart.CFrame
                                            otherMob.Humanoid.WalkSpeed = 0
                                            otherMob.Humanoid.JumpPower = 0
                                        end
                                    end
                                end
                            end
                        else
                            -- Bay chờ quái hồi (lơ lửng 30m)
                            topos(questData.PosM * CFrame.new(0, 30, 0))
                        end
                    end
                end
            end)
        end
    end
end)

