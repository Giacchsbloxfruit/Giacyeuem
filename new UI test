-- Hàm Tween
function StopTween()
    if _G.CurrentTween then
        _G.CurrentTween:Cancel()
        _G.CurrentTween = nil
    end
    _G.LastTargetPos = nil
    
    local char = game.Players.LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root then
        -- Dừng quán tính hoàn toàn
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        if char:FindFirstChild("Humanoid") then
            char.Humanoid.PlatformStand = false
        end
    end
end

function topos(targetCFrame)
    local char = game.Players.LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    -- Tốc độ dựa trên biến _G.TweenSpeed
    local speed = (type(_G.TweenSpeed) == "number") and _G.TweenSpeed or 250
    local dist = (targetCFrame.Position - root.Position).Magnitude
    
    -- Kiểm tra nếu đã quá gần thì không cần Tween
    if dist < 10 then 
        root.CFrame = targetCFrame 
        return 
    end

    -- Hủy cái cũ để tránh chồng chéo
    StopTween()

    -- Bật PlatformStand để nhân vật không bị khựng bởi va chạm vật lý khi bay
    if char:FindFirstChild("Humanoid") then
        char.Humanoid.PlatformStand = true
    end

    _G.LastTargetPos = targetCFrame
    local info = TweenInfo.new(dist / speed, Enum.EasingStyle.Linear)
    _G.CurrentTween = game:GetService("TweenService"):Create(root, info, {CFrame = targetCFrame})
    
    _G.CurrentTween.Completed:Connect(function()
        if _G.CurrentTween then
            _G.LastTargetPos = nil
            _G.CurrentTween = nil
            if char:FindFirstChild("Humanoid") then
                char.Humanoid.PlatformStand = false
            end
        end
    end)

    _G.CurrentTween:Play()
end
