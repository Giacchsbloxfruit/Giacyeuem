function KillElitePriority()
    local eliteNames = {"Diablo", "Deandre", "Urban"}
    local targetMob = nil
    
    -- Tìm quái Elite
    for _, name in pairs(eliteNames) do
        local found = game:GetService("Workspace").Enemies:FindFirstChild(name)
        if found and found:FindFirstChild("Humanoid") and found.Humanoid.Health > 0 then
            targetMob = found
            break
        end
    end

    if targetMob then
        _G.IsDoingElite = true -- Đánh dấu trạng thái bận
        StopAllFarms()        -- Tắt mọi loại farm khác ngay lập tức
        
        repeat
            task.wait()
            pcall(function()
                EquipWeapon(_G.SelectWeapon)
                AutoHaki()
                
                -- Khóa quái
                targetMob.HumanoidRootPart.CanCollide = false
                targetMob.Humanoid.WalkSpeed = 0
                
                -- Di chuyển đến vị trí trên đầu quái
                topos(targetMob.HumanoidRootPart.CFrame * CFrame.new(0, 30, 0))
                
                -- Tấn công
                game:GetService("VirtualUser"):CaptureController()
                game:GetService("VirtualUser"):Button1Down(Vector2.new(1280, 672))
            end)
        until not targetMob or targetMob.Humanoid.Health <= 0 or not _G.AutoElitehunter
        
        _G.IsDoingElite = false
        return true
    end
    
    return false
end

