-- Cập nhật FPS & Ping
local frames = 0
RunService.RenderStepped:Connect(function() frames = frames + 1 end)

task.spawn(function()
    while task.wait(1) do
        local fps = frames
        frames = 0
        local success, pingStr = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValueString() end)
        local ping = success and string.match(pingStr, "%d+") or "--"
        StatsLabel.Text = string.format("FPS: %d | Ping: %sms", fps, tostring(ping))
    end
end)

local function PlayIndex(index)
    if not Playlist[index] then return end
    CurrentIndex = index
    Sound.SoundId = "rbxassetid://" .. tostring(Playlist[index].Id)
    Sound:Play()
    IsPlaying = true
    PlayBtn.Text = "⏸"
    TitleLabel.Text = Playlist[index].Name
end

PlayBtn.MouseButton1Click:Connect(function()
    if not Sound.SoundId or Sound.SoundId == "" then PlayIndex(CurrentIndex) return end
    if IsPlaying then Sound:Pause() PlayBtn.Text = "▶"
    else Sound:Resume() PlayBtn.Text = "⏸" end
    IsPlaying = not IsPlaying
end)

NextBtn.MouseButton1Click:Connect(function()
    CurrentIndex = (CurrentIndex % #Playlist) + 1
    PlayIndex(CurrentIndex)
end)

PrevBtn.MouseButton1Click:Connect(function()
    CurrentIndex = CurrentIndex - 1
    if CurrentIndex < 1 then CurrentIndex = #Playlist end
    PlayIndex(CurrentIndex)
end)

Sound.Ended:Connect(function()
    CurrentIndex = (CurrentIndex % #Playlist) + 1
    PlayIndex(CurrentIndex)
end)

local function PopulateList(filterText)
    for _, v in pairs(Scroll:GetChildren()) do if v:IsA("TextButton") then v:Destroy() end end
    filterText = filterText and filterText:lower() or ""
    
    for i, song in ipairs(Playlist) do
        if filterText == "" or song.Name:lower():find(filterText) then
            local btn = Instance.new("TextButton", Scroll)
            btn.Size = UDim2.new(1, -4, 0, 22)
            btn.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
            btn.Text = "  " .. i .. ". " .. song.Name
            btn.TextColor3 = Color3.fromRGB(220, 220, 220)
            btn.TextXAlignment = Enum.TextXAlignment.Left
            btn.Font = Enum.Font.Gotham
            btn.TextSize = 11
            Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
            
            btn.MouseButton1Down:Connect(function() CreateRipple(btn) end)
            btn.MouseButton1Click:Connect(function() PlayIndex(i) end)
        end
    end
    Scroll.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y)
end

