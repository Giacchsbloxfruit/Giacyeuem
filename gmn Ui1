local Library = {}
Library.__index = Library

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")

local function Create(className, properties, children)
    local inst = Instance.new(className)
    for k, v in pairs(properties or {}) do
        inst[k] = v
    end
    for _, child in pairs(children or {}) do
        child.Parent = inst
    end
    return inst
end

local function Tween(obj, props, time)
    local tw = TweenService:Create(obj, TweenInfo.new(time or 0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), props)
    tw:Play()
    return tw
end

function Library:CreateWindow(options)
    options = options or {}
    local Window = setmetatable({}, Library)
    Window.Title = options.Title or "SCRIPT LIBRARY HUB"
    
    local targetGui = (gethui and gethui()) or CoreGui:FindFirstChild("RobloxGui") or Players.LocalPlayer.PlayerGui
    if targetGui:FindFirstChild("AxiomHub_Production") then
        targetGui:FindFirstChild("AxiomHub_Production"):Destroy()
    end

    Window.ScreenGui = Create("ScreenGui", {
        Name = "AxiomHub_Production",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        Parent = targetGui
    })

    Window.MainFrame = Create("Frame", {
        Size = UDim2.new(0, 920, 0, 520),
        Position = UDim2.new(0.5, -460, 0.5, -260),
        BackgroundColor3 = Color3.fromRGB(248, 249, 250),
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Parent = Window.ScreenGui
    }, {
        Create("UICorner", {CornerRadius = UDim.new(0, 16)}),
        Create("UIStroke", {Color = Color3.fromRGB(230, 230, 235), Thickness = 1})
    })

    -- Dragging logic
    local dragging, dragInput, dragStart, startPos
    Window.MainFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = Window.MainFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    Window.MainFrame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then dragInput = input end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            Window.MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    -- Header Title
    Create("TextLabel", {
        Size = UDim2.new(0, 300, 0, 60),
        Position = UDim2.new(0, 50, 0, 0),
        BackgroundTransparency = 1,
        Text = Window.Title,
        Font = Enum.Font.GothamBold,
        TextSize = 14,
        TextColor3 = Color3.fromRGB(15, 15, 15),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = Window.MainFrame
    })

    -- Sidebar Container
    Window.Sidebar = Create("ScrollingFrame", {
        Size = UDim2.new(0, 200, 1, -60),
        Position = UDim2.new(0, 0, 0, 60),
        BackgroundTransparency = 1,
        ScrollBarThickness = 0,
        Parent = Window.MainFrame
    }, {
        Create("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6)}),
        Create("UIPadding", {PaddingLeft = UDim.new(0, 15), PaddingRight = UDim.new(0, 15)}),
        Create("Frame", {
            Size = UDim2.new(0, 1, 1, 0),
            Position = UDim2.new(1, 0, 0, 0),
            BackgroundColor3 = Color3.fromRGB(230, 230, 235),
            BorderSizePixel = 0
        })
    })

    -- Content Area
    Window.ContentArea = Create("Frame", {
        Size = UDim2.new(1, -210, 1, -60),
        Position = UDim2.new(0, 205, 0, 60),
        BackgroundTransparency = 1,
        Parent = Window.MainFrame
    })

    return Window
end

function Library:AddTab(options)
    local tabName = (type(options) == "table" and options.Title) or options
    local tab = {Name = tabName, Window = self}

    local TabBtn = Create("TextButton", {
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundColor3 = Color3.fromRGB(248, 249, 250),
        Text = "    " .. tabName,
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        TextColor3 = Color3.fromRGB(120, 120, 125),
        TextXAlignment = Enum.TextXAlignment.Left,
        AutoButtonColor = false,
        Parent = self.Window.Sidebar
    }, {
        Create("UICorner", {CornerRadius = UDim.new(0, 8)})
    })

    local ActiveIndicator = Create("Frame", {
        Size = UDim2.new(0, 3, 0, 20),
        Position = UDim2.new(1, -3, 0.5, -10),
        BackgroundColor3 = Color3.fromRGB(15, 15, 15),
        BorderSizePixel = 0,
        Visible = false,
        Parent = TabBtn
    }, {Create("UICorner", {CornerRadius = UDim.new(1, 0)})})

    local TabContent = Create("ScrollingFrame", {
        Size = UDim2.new(1, -20, 1, -10),
        Position = UDim2.new(0, 10, 0, 0),
        BackgroundTransparency = 1,
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = Color3.fromRGB(200, 200, 200),
        Visible = false,
        Parent = self.Window.ContentArea
    }, {
        Create("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 15)}),
        Create("UIPadding", {PaddingBottom = UDim.new(0, 20), PaddingRight = UDim.new(0, 10)})
    })

    tab.Container = TabContent

    TabBtn.MouseButton1Click:Connect(function()
        for _, child in pairs(self.Window.ContentArea:GetChildren()) do
            if child:IsA("ScrollingFrame") then child.Visible = false end
        end
        for _, child in pairs(self.Window.Sidebar:GetChildren()) do
            if child:IsA("TextButton") then
                Tween(child, {BackgroundColor3 = Color3.fromRGB(248, 249, 250), TextColor3 = Color3.fromRGB(120, 120, 125)})
                if child:FindFirstChild("Frame") then child.Frame.Visible = false end
            end
        end
        TabContent.Visible = true
        ActiveIndicator.Visible = true
        Tween(TabBtn, {BackgroundColor3 = Color3.fromRGB(230, 232, 235), TextColor3 = Color3.fromRGB(15, 15, 15)})
    end)

    if #self.Window.Sidebar:GetChildren() == 3 then -- Initial tab selection
        TabContent.Visible = true
        ActiveIndicator.Visible = true
        TabBtn.BackgroundColor3 = Color3.fromRGB(230, 232, 235)
        TabBtn.TextColor3 = Color3.fromRGB(15, 15, 15)
    end

    -- Toggle Component (Title, Default, Callback)
    function tab:AddToggle(opts)
        opts = opts or {}
        local state = opts.Default or false
        local cb = opts.Callback or function() end

        local ToggleFrame = Create("Frame", {
            Size = UDim2.new(1, 0, 0, 45),
            BackgroundColor3 = Color3.fromRGB(255, 255, 255),
            Parent = self.Container
        }, {
            Create("UICorner", {CornerRadius = UDim.new(0, 10)}),
            Create("UIStroke", {Color = Color3.fromRGB(230, 230, 235), Thickness = 1}),
            Create("TextLabel", {
                Size = UDim2.new(1, -80, 1, 0),
                Position = UDim2.new(0, 15, 0, 0),
                BackgroundTransparency = 1,
                Text = opts.Title or "Toggle",
                Font = Enum.Font.GothamSemibold,
                TextSize = 12,
                TextColor3 = Color3.fromRGB(20, 20, 20),
                TextXAlignment = Enum.TextXAlignment.Left
            })
        })

        local ToggleOuter = Create("Frame", {
            Size = UDim2.new(0, 42, 0, 22),
            Position = UDim2.new(1, -57, 0.5, -11),
            BackgroundColor3 = state and Color3.fromRGB(15, 15, 15) or Color3.fromRGB(210, 212, 218),
            Parent = ToggleFrame
        }, {
            Create("UICorner", {CornerRadius = UDim.new(1, 0)}),
            Create("Frame", {
                Name = "InnerKnob",
                Size = UDim2.new(0, 18, 0, 18),
                Position = UDim2.new(0, state and 22 or 2, 0.5, -9),
                BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                Parent = ToggleOuter
            }, {Create("UICorner", {CornerRadius = UDim.new(1, 0)})})
        })

        local Btn = Create("TextButton", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", Parent = ToggleFrame})
        Btn.MouseButton1Click:Connect(function()
            state = not state
            Tween(ToggleOuter, {BackgroundColor3 = state and Color3.fromRGB(15, 15, 15) or Color3.fromRGB(210, 212, 218)}, 0.15)
            Tween(ToggleOuter.InnerKnob, {Position = UDim2.new(0, state and 22 or 2, 0.5, -9)}, 0.15)
            cb(state)
        end)
    end

    -- Button Component (Title, Callback)
    function tab:AddButton(opts)
        opts = opts or {}
        local cb = opts.Callback or function() end
        local BtnFrame = Create("Frame", {
            Size = UDim2.new(1, 0, 0, 40),
            BackgroundTransparency = 1,
            Parent = self.Container
        })
        
        local Btn = Create("TextButton", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundColor3 = Color3.fromRGB(15, 15, 15),
            Text = opts.Title or "Button",
            Font = Enum.Font.GothamBold,
            TextSize = 12,
            TextColor3 = Color3.fromRGB(255, 255, 255),
            Parent = BtnFrame
        }, {Create("UICorner", {CornerRadius = UDim.new(0, 8)})})

        Btn.MouseButton1Click:Connect(function()
            Tween(Btn, {Size = UDim2.new(0.98, 0, 0.9, 0)}, 0.05).Completed:Wait()
            Tween(Btn, {Size = UDim2.new(1, 0, 1, 0)}, 0.05)
            cb()
        end)
    end

    -- Slider Component (Title, Min, Max, Default, Callback)
    function tab:AddSlider(opts)
        opts = opts or {}
        local min, max = opts.Min or 0, opts.Max or 100
        local val = opts.Default or min
        local cb = opts.Callback or function() end

        local SliderFrame = Create("Frame", {
            Size = UDim2.new(1, 0, 0, 55),
            BackgroundColor3 = Color3.fromRGB(255, 255, 255),
            Parent = self.Container
        }, {
            Create("UICorner", {CornerRadius = UDim.new(0, 10)}),
            Create("UIStroke", {Color = Color3.fromRGB(230, 230, 235), Thickness = 1}),
            Create("TextLabel", {
                Size = UDim2.new(1, -30, 0, 25),
                Position = UDim2.new(0, 15, 0, 2),
                BackgroundTransparency = 1,
                Text = opts.Title or "Slider",
                Font = Enum.Font.GothamSemibold,
                TextSize = 12,
                TextColor3 = Color3.fromRGB(20, 20, 20),
                TextXAlignment = Enum.TextXAlignment.Left
            })
        })

        local ValueLabel = Create("TextLabel", {
            Size = UDim2.new(0, 50, 0, 25),
            Position = UDim2.new(1, -65, 0, 2),
            BackgroundTransparency = 1,
            Text = tostring(val),
            Font = Enum.Font.Gotham,
            TextSize = 11,
            TextColor3 = Color3.fromRGB(100, 100, 105),
            TextXAlignment = Enum.TextXAlignment.Right,
            Parent = SliderFrame
        })

        local Track = Create("Frame", {
            Size = UDim2.new(1, -30, 0, 6),
            Position = UDim2.new(0, 15, 0, 35),
            BackgroundColor3 = Color3.fromRGB(230, 232, 238),
            Parent = SliderFrame
        }, {
            Create("UICorner", {CornerRadius = UDim.new(1, 0)}),
            Create("Frame", {
                Name = "Fill",
                Size = UDim2.new(math.clamp((val - min) / (max - min), 0, 1), 0, 1, 0),
                BackgroundColor3 = Color3.fromRGB(15, 15, 15),
                Parent = Track
            }, {Create("UICorner", {CornerRadius = UDim.new(1, 0)})})
        })

        local Btn = Create("TextButton", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", Parent = Track})
        local dragging = false
        Btn.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                local pct = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
                val = math.floor(min + (max - min) * pct)
                Tween(Track.Fill, {Size = UDim2.new(pct, 0, 1, 0)}, 0.05)
                ValueLabel.Text = tostring(val)
                cb(val)
            end
        end)
    end

    -- Input Component (Title, Default, Callback)
    function tab:AddInput(opts)
        opts = opts or {}
        local cb = opts.Callback or function() end
        local InputFrame = Create("Frame", {
            Size = UDim2.new(1, 0, 0, 45),
            BackgroundColor3 = Color3.fromRGB(255, 255, 255),
            Parent = self.Container
        }, {
            Create("UICorner", {CornerRadius = UDim.new(0, 10)}),
            Create("UIStroke", {Color = Color3.fromRGB(230, 230, 235), Thickness = 1}),
            Create("TextLabel", {
                Size = UDim2.new(0.4, 0, 1, 0),
                Position = UDim2.new(0, 15, 0, 0),
                BackgroundTransparency = 1,
                Text = opts.Title or "Input",
                Font = Enum.Font.GothamSemibold,
                TextSize = 12,
                TextColor3 = Color3.fromRGB(20, 20, 20),
                TextXAlignment = Enum.TextXAlignment.Left
            })
        })

        local TextBox = Create("TextBox", {
            Size = UDim2.new(0.55, 0, 0.65, 0),
            Position = UDim2.new(0.42, 0, 0.175, 0),
            BackgroundColor3 = Color3.fromRGB(245, 246, 248),
            PlaceholderText = opts.Default or "Enter text...",
            Text = "",
            Font = Enum.Font.Gotham,
            TextSize = 11,
            TextColor3 = Color3.fromRGB(20, 20, 20),
            Parent = InputFrame
        }, {Create("UICorner", {CornerRadius = UDim.new(0, 6)})})

        TextBox.FocusLost:Connect(function()
            cb(TextBox.Text)
        end)
    end

    return tab
end

return Library
