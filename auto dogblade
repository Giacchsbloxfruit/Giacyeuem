-- Hàm Farm Nearest
local function KillNearestMob()
    local MaxDistance = 1000 
    local enemies = game:GetService("Workspace"):FindFirstChild("Enemies")
    local player = game:GetService("Players").LocalPlayer
    
    if not enemies or not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then return end

    local targetMob = nil
    local minDist = MaxDistance

    pcall(function()
        for _, v in pairs(enemies:GetChildren()) do
            if v:FindFirstChild("Humanoid") and v:FindFirstChild("HumanoidRootPart") and v.Humanoid.Health > 0 then
                local dist = (player.Character.HumanoidRootPart.Position - v.HumanoidRootPart.Position).Magnitude
                if dist < minDist then
                    minDist = dist
                    targetMob = v
                end
            end
        end

        if targetMob then
            EquipWeapon()
            local targetCF = targetMob.HumanoidRootPart.CFrame * CFrame.new(0, 8, 0)
            topos(targetCF)

            local vu = game:GetService("VirtualUser")
            vu:CaptureController()
            vu:Button1Down(Vector2.new(1280, 672))

            targetMob.HumanoidRootPart.CanCollide = false
            targetMob.Humanoid.WalkSpeed = 0
            if targetMob.HumanoidRootPart.Size ~= Vector3.new(2, 2, 1) then
                targetMob.HumanoidRootPart.Size = Vector3.new(2, 2, 1)
            end
        end
    end)
end

