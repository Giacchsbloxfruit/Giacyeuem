-- [ 5. HÀM TWEEN VIP & CÁC HÀM HỖ TRỢ FARM ]
-- ==========================================
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local CurrentTween = nil
local NoclipConnection = nil

local function StopTween()
    _G.IsTweening = false
    if CurrentTween then 
        CurrentTween:Cancel() 
        CurrentTween = nil 
    end
    if NoclipConnection then 
        NoclipConnection:Disconnect() 
        NoclipConnection = nil 
    end
    pcall(function()
        local hrp = LocalPlayer.Character.HumanoidRootPart
        if hrp:FindFirstChild("VIP_Hover") then hrp.VIP_Hover:Destroy() end
    end)
end

local function VIP_Tween(TargetCFrame)
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart")
    
    local Distance = (hrp.Position - TargetCFrame.Position).Magnitude
    local Speed = 240
    local Time = Distance / Speed
    
    if Time <= 0 then Time = 0.01 end 
    
    local AntiFall = hrp:FindFirstChild("VIP_Hover") or Instance.new("BodyVelocity", hrp)
    AntiFall.Name = "VIP_Hover"
    AntiFall.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    AntiFall.Velocity = Vector3.zero

    if not NoclipConnection then
        NoclipConnection = RunService.Stepped:Connect(function()
            if char then
                for _, v in pairs(char:GetDescendants()) do
                    if v:IsA("BasePart") then v.CanCollide = false end
                end
            end
        end)
    end

    if CurrentTween then CurrentTween:Cancel() end

    local TInfo = TweenInfo.new(Time, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
    CurrentTween = TweenService:Create(hrp, TInfo, {CFrame = TargetCFrame})
    
    _G.IsTweening = true
    CurrentTween:Play()
    return CurrentTween 
end

local function EquipWeapon()
    pcall(function()
        local char = LocalPlayer.Character
        if char:FindFirstChildOfClass("Tool") then return end 
        
        for _, v in pairs(LocalPlayer.Backpack:GetChildren()) do
            if v.ToolTip == "Melee" or v.Name == "Combat" then 
                char.Humanoid:EquipTool(v)
                break 
            end
        end
    end)
end

local function topos(TargetCFrame)
    pcall(function()
        local hrp = LocalPlayer.Character.HumanoidRootPart
        local dist = (hrp.Position - TargetCFrame.Position).Magnitude
        
        if dist > 0.5 then
            VIP_Tween(TargetCFrame)
        end
    end)
end

