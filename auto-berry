--======================================================--
-- CHARACTER
--======================================================--

local function GetCharacter()
    local Character = Player.Character

    if not Character or not Character.Parent then
        return nil
    end

    return Character
end

local function GetRoot()
    local Character = GetCharacter()

    if not Character then
        return nil
    end

    return Character:FindFirstChild("HumanoidRootPart")
end

--======================================================--
-- UPDATE MOVEMENT STATE
--======================================================--

task.spawn(function()

    while task.wait(0.03) do

        local Character = GetCharacter()
        local Root = GetRoot()

        if not Character or not Root then
            continue
        end

        if shouldTween then

            if not isTravelling then
                block.CFrame = Root.CFrame
            end

            for _, Object in ipairs(
                Character:GetDescendants()
            ) do

                if Object:IsA("BasePart") then
                    Object.CanCollide = false
                end

            end

        else

            if not isTravelling then
                block.CFrame = Root.CFrame
            end

            for _, Object in ipairs(
                Character:GetDescendants()
            ) do

                if Object:IsA("BasePart") then
                    Object.CanCollide = true
                end

            end

        end

    end

end)

--======================================================--
-- TWEEN
--======================================================--

_tp = function(target, speed)

    local Character = GetCharacter()
    local Root = GetRoot()

    if not Character or not Root then
        return false
    end

    if typeof(target) ~= "CFrame" then
        return false
    end

    speed = tonumber(speed) or _G.TweenSpeed

    if speed <= 0 then
        speed = 200
    end

    tweenToken += 1
    local thisToken = tweenToken

    if activeTween then
        pcall(function()
            activeTween:Cancel()
        end)
    end

    local startPosition = Root.Position
    local targetPosition = target.Position

    local distance =
        (targetPosition - startPosition).Magnitude

    if distance <= 2 then
        block.CFrame = target
        return true
    end

    local duration =
        math.max(distance / speed, 0.05)

    shouldTween = true
    isTravelling = true

    block.CFrame = Root.CFrame

    local TweenInfoObject = TweenInfo.new(
        duration,
        Enum.EasingStyle.Linear,
        Enum.EasingDirection.Out
    )

    local Success, TweenObject = pcall(function()
        return TweenService:Create(
            block,
            TweenInfoObject,
            {
                CFrame = target
            }
        )
    end)

    if not Success or not TweenObject then
        isTravelling = false
        return false
    end

    activeTween = TweenObject
    TweenObject:Play()

    task.spawn(function()

        while
            _G.AutoBerry
            and shouldTween
            and thisToken == tweenToken
            and TweenObject.PlaybackState
                == Enum.PlaybackState.Playing
        do

            local CurrentRoot = GetRoot()

            if not CurrentRoot then
                break
            end

            CurrentRoot.CFrame =
                block.CFrame

            task.wait()

        end

        if thisToken == tweenToken then

            pcall(function()
                TweenObject:Cancel()
            end)

            activeTween = nil
            isTravelling = false

        end

    end)

    return true
end

--======================================================--
-- STOP
--======================================================--

local function StopTween()

    tweenToken += 1

    if activeTween then
        pcall(function()
            activeTween:Cancel()
        end)
        activeTween = nil
    end

    isTravelling = false

    local Root = GetRoot()

    if Root then
        block.CFrame = Root.CFrame
    end

end

